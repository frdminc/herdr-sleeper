SESSION_ID = re.compile(r"[A-Za-z0-9_/][A-Za-z0-9_.:@+=/-]{0,299}\Z")


def valid_session_id(value: object) -> bool:
    """A session id we will type into a shell line or put in an argv. Herdr gets it from the agent, so a pane's
    own program chooses it: refuse anything but a plain token (no quotes, spaces, `;`, `$`, backslash, newline,
    a leading `-`). Real ids seen: uuids, opencode `ses_...`, letta `default:<agent>`, and for pi and kimi a
    session file path (so `/` passes; a path with a space is refused, fail closed)."""
    return isinstance(value, str) and SESSION_ID.match(value) is not None


def kind_binary(kind: str) -> str:
    return KINDS.get(kind, {}).get("binary") or kind


def resume_tokens(kind: str, uuid: str) -> list[str] | None:
    """The tokens that select this session, in the form KINDS gives for the kind; None for an unknown kind."""
    spec = KINDS.get(kind)
    if spec is None:
        return None
    if not valid_session_id(uuid):
        return None
    how, tok = spec["resume"]
    if kind == "letta" and uuid.startswith("default:"):  # Herdr: the default conversation of one agent
        return ["--conversation", "default", "--agent", uuid[len("default:"):]] if uuid[8:] else None
    return [f"{tok}={uuid}"] if how == "eq" else [tok, uuid]


def resume_argv(kind: str, uuid: str, extra: list[str] | None = None) -> list[str] | None:
    """The argv after the agent binary that resumes exactly this session (the launch flags in `extra` first)."""
    tokens = resume_tokens(kind, uuid)
    return None if tokens is None else [*(extra or []), *tokens]


def flag_names(tokens: list[str]) -> list[str]:
    """Option names only, for logs, events and notifications: an option's value may be a secret."""
    return [t.split("=", 1)[0] for t in tokens if t.startswith("-")]


def mask_flag_values(tokens: list[str]) -> list[str]:
    """`tokens` with every option value replaced by an ellipsis (names stay), for the sleeper.log copy of a
    manual resume line."""
    return [t.split("=", 1)[0] + "=…" if t.startswith("-") and "=" in t else t if t.startswith("-") else "…"
            for t in tokens]


LOG_MASKS: dict[str, str] = {}   # full manual line -> the same with option values masked (see say)


def manual_command(entry: dict) -> str:
    """The by-hand resume line printed when we refuse to act automatically. The operator sees it whole; `say`
    writes the masked form to sleeper.log (an option value may be a secret)."""
    kind = entry.get("kind") or "claude"
    extra: list[str] = []
    if kind in KINDS and (PROFILES.get(kind, {}).get("argv_after_binary") or entry.get("restore_repair")
                          or entry.get("repair")):
        extra, _why = replayable_argv(entry.get("argv") or [], kind)
    argv = resume_argv(kind, entry["uuid"], extra or None)
    if argv is None:
        return f"(no resume recipe for {kind}; session {entry['uuid']})"
    head = f"cd {shlex.quote(entry.get('cwd') or '.')} && "
    full = head + shlex.join([kind_binary(kind), *argv])
    if extra:
        if len(LOG_MASKS) > 200:
            LOG_MASKS.clear()
        masked = resume_argv(kind, entry["uuid"], mask_flag_values(extra)) or []
        LOG_MASKS[full] = head + shlex.join([kind_binary(kind), *masked])
    return full


# -------------------------------------------------------------------- output

def ensure_state_dir() -> None:
    """The state dir exists and is private (0700): the logs and journals in it hold argv, cwd and flags."""
    STATE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    with contextlib.suppress(OSError):
        os.chmod(STATE_DIR, 0o700)  # one created by an older version under the umask


def open_private_append(path: Path):  # type: ignore[no-untyped-def]
    """Open `path` for appending, created 0600 (and tightened when it already exists)."""
    fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    with contextlib.suppress(OSError):
        os.fchmod(fd, 0o600)
    return os.fdopen(fd, "a")


def say(msg: str) -> None:
    """Diagnostics: to the log always, to stderr too.

    Both get the masked copy of a manual resume line (option values hidden) unless stderr is a terminal: a person
    running `herdr-sleeper wake` there wants the full command to paste, while a hook, a plugin action or the
    watcher has stderr on a pipe or /dev/null that Herdr may keep. (The `print`ed manual lines of the interactive
    commands are always full.)
    """
    logged = msg
    for full, masked in LOG_MASKS.items():
        logged = logged.replace(full, masked)
    line = f"{dt.datetime.now().isoformat(timespec='seconds')} {logged}"
    try:
        ensure_state_dir()
        with open_private_append(LOGFILE) as fh:
            fh.write(line + "\n")
    except OSError:
        pass
    try:
        interactive = sys.stderr.isatty()
    except (AttributeError, ValueError):
        interactive = False
    print(msg if interactive else logged, file=sys.stderr)


def stamp(ts: float | None = None) -> str:
    """Local wall-clock time as ISO seconds, the format the state files use (now, or the epoch `ts`)."""
    return time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(ts))


def event(what: str, **fields: object) -> None:
    """Append one structured record to events.jsonl (what `log` shows)."""
    try:
        ensure_state_dir()
        rec = {"at": dt.datetime.now().isoformat(timespec="seconds"), "event": what, **fields}
        with open_private_append(EVENTS) as fh:
            fh.write(json.dumps(rec, sort_keys=True) + "\n")
    except OSError as exc:
        say(f"WARN could not write event: {exc}")


def notify(title: str, body: str = "", enabled: bool = True) -> None:
    if not enabled:
        return
    herdr("notification", "show", title, *(["--body", body] if body else []), check=False, timeout=10)


# ---------------------------------------------------------------- json state

def write_json(path: Path, data: object) -> None:
    ensure_state_dir()
    fd, tmp = tempfile.mkstemp(prefix=path.name + ".", suffix=".tmp", dir=path.parent)
    with os.fdopen(fd, "w") as fh:
        fh.write(json.dumps(data, indent=2, sort_keys=True) + "\n")
    os.replace(tmp, path)


def quarantine(path: Path) -> Path:
    """Move a damaged state file aside (never overwrite evidence) and return where it went."""
    aside = path.with_name(f"{path.name}.damaged-{dt.datetime.now().strftime('%Y%m%dT%H%M%S')}")
    os.replace(path, aside)
    return aside


def read_json(path: Path) -> dict:
    if not path.exists():
        return {}
    try:
        text = path.read_text()
    except OSError as exc:
        raise SleeperError(f"{path} could not be read ({exc}); refusing to act without it")
    try:
        data = json.loads(text)
    except json.JSONDecodeError as exc:
        raise DamagedState(f"{path} is not valid JSON ({exc}); refusing to act on a damaged state file")
    if not isinstance(data, dict):
        raise DamagedState(f"{path} does not hold a JSON object; refusing to act on a damaged state file")
    return data


class locked:
    """Interprocess lock around a whole sleep/wake transaction (watcher + hooks may overlap).

    With a timeout, gives up with SleeperError instead of queueing: focus hooks
    use that so a burst of them cannot pile up behind a 25 s sleep transaction
    against Herdr's cap on in-flight plugin commands.
    """

    def __init__(self, timeout: float | None = None) -> None:
        self.timeout = timeout

    def __enter__(self) -> "locked":
        ensure_state_dir()
        self.fh = LOCK.open("a+")
        try:
            fcntl.flock(self.fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return self
        except OSError:
            pass
        if self.timeout is None:
            say("another herdr-sleeper holds the lock; waiting")
            fcntl.flock(self.fh, fcntl.LOCK_EX)
            return self
        for _ in range(max(1, int(self.timeout * 4))):
            time.sleep(0.25)
            try:
                fcntl.flock(self.fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except OSError:
                continue
        self.fh.close()
        raise SleeperError(f"busy: another herdr-sleeper held the lock for {self.timeout:g}s")

    def __exit__(self, *exc: object) -> None:
        fcntl.flock(self.fh, fcntl.LOCK_UN)
        self.fh.close()


# --------------------------------------------------------------- herdr calls

def herdr(*args: str, check: bool = True, timeout: float = HERDR_TIMEOUT) -> dict:
    """Run a `herdr` CLI command and return its parsed JSON `result`.

    Herdr prints `{"error": {...}}` with exit 0 on failure, so the envelope is
    what we trust, not the exit code. With check=False a failure returns {}.
    """
    try:
        proc = subprocess.run([HERDR_BIN, *args], capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        if check:
            raise SleeperError(f"herdr {' '.join(args[:2])} timed out after {timeout}s")
        return {}
    except FileNotFoundError:
        raise SleeperError(f"`{HERDR_BIN}` not found (set HERDR_BIN_PATH or fix PATH)")
    out = proc.stdout.strip()
    payload: dict | None = None
    if out.startswith("{"):
        try:
            payload = json.loads(out)
        except json.JSONDecodeError:
            payload = None
    if payload is None or "error" in payload or proc.returncode != 0:
        if check:
            detail = (payload or {}).get("error") or proc.stderr.strip() or out[:200] or f"exit {proc.returncode}"
            raise SleeperError(f"herdr {' '.join(args[:2])} failed: {detail}")
        return {}
    result = payload.get("result")
    if not isinstance(result, dict):
        if check:
            raise SleeperError(f"herdr {' '.join(args[:2])}: malformed envelope (result is {type(result).__name__})")
        return {}
    return result


def herdr_screen(pane: str) -> str | None:
    """The pane's screen as plain text, or None when it could not be read."""
    try:
        proc = subprocess.run([HERDR_BIN, "pane", "read", pane], capture_output=True, text=True, timeout=HERDR_TIMEOUT)
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return None
    if proc.returncode != 0 or proc.stdout.lstrip().startswith('{"error"'):
        return None
    return proc.stdout


def list_agents() -> list[dict]:
    agents = herdr("agent", "list").get("agents")
    if not isinstance(agents, list) or not all(isinstance(a, dict) and isinstance(a.get("pane_id"), str) for a in agents):
        raise SleeperError("herdr agent list: malformed agents payload")
    return agents


def valid_entry(entry: object) -> bool:
    """A journal/snapshot entry we are willing to act on."""
    return (isinstance(entry, dict) and isinstance(entry.get("pane_id"), str)
            and valid_session_id(entry.get("uuid")) and isinstance(entry.get("kind"), str))


# -------------------------------------------------------------------- config

def parse_duration(text: str) -> float:
    """'12h', '90m', '1d', '1.5h', or a bare number of hours → hours."""
    m = re.fullmatch(r"\s*(\d+(?:\.\d+)?)\s*([smhd]?)\s*", str(text))
    if not m:
        raise ConfigError(f"bad duration {text!r}; use e.g. 12h, 90m, 1d")
    n, unit = float(m.group(1)), m.group(2) or "h"
    return n * {"s": 1 / 3600, "m": 1 / 60, "h": 1.0, "d": 24.0}[unit]


TOML_STRING = r'"[^"\\]*"'


def _strip_comment(line: str) -> str:
    """Drop a `#` comment, but not a `#` inside a double-quoted string."""
    in_string = False
    for i, ch in enumerate(line):
        if ch == '"':
            in_string = not in_string
        elif ch == "#" and not in_string:
            return line[:i]
    return line


def _toml_subset(path: Path) -> dict:
    """Parse the small TOML subset the config uses, for interpreters without tomllib.

    Understands `key = value` with a double-quoted string (no escapes), number,
    boolean, or one-line list of such strings; plain `[name]` table headers (one
    level, as `[restore]`); `#` comments outside strings; blank lines. Anything
    else — escapes, dotted keys, arrays of tables, multi-line values, duplicate
    keys or tables — raises ConfigError: a config we cannot parse exactly as
    tomllib would must disable sleeping, not half-apply.
    """
    out: dict = {}
    target = out  # the table keys currently land in: the root, until a [name] header
    for n, line in enumerate(path.read_text().splitlines(), 1):
        line = _strip_comment(line).strip()
        if not line:
            continue
        header = re.fullmatch(r"\[\s*([A-Za-z0-9_-]+)\s*\]", line)
        if header:
            if header.group(1) in out:
                raise ConfigError(f"line {n}: duplicate key or table {header.group(1)!r}")
            target = out[header.group(1)] = {}
            continue
        m = re.fullmatch(r"([A-Za-z0-9_-]+)\s*=\s*(.+)", line)
        if not m:
            raise ConfigError(f"line {n}: not `key = value`")
        key, raw = m.group(1), m.group(2).strip()
        if key in target:
            raise ConfigError(f"line {n}: duplicate key {key!r}")
        if "\\" in raw:
            raise ConfigError(f"line {n}: string escapes are not supported")
        if raw.startswith("["):
            if not re.fullmatch(rf"\[\s*(?:{TOML_STRING}\s*(?:,\s*{TOML_STRING}\s*)*,?\s*)?\]", raw):
                raise ConfigError(f"line {n}: only one-line lists of quoted strings are supported")
            target[key] = re.findall(r'"([^"\\]*)"', raw)
        elif re.fullmatch(TOML_STRING, raw):
            target[key] = raw[1:-1]
        elif raw in ("true", "false"):
            target[key] = raw == "true"
        elif re.fullmatch(r"[+-]?\d+", raw):
            target[key] = int(raw)
        elif re.fullmatch(r"[+-]?(?:\d+(?:\.\d+)?(?:[eE][+-]?\d+)?|inf|nan)", raw):
            target[key] = float(raw)
        else:
            raise ConfigError(f"line {n}: unsupported value {raw!r}")
    return out


def parse_toml(path: Path) -> dict:
    return tomllib.loads(path.read_text()) if tomllib else _toml_subset(path)


def _env_bool(var: str, raw: str) -> bool:
    low = raw.strip().lower()
    if low in ("1", "true", "yes", "on"):
        return True
    if low in ("0", "false", "no", "off"):
        return False
    raise ConfigError(f"${var} must be a boolean (true/false/1/0), got {raw!r}")


def load_config() -> tuple[dict, dict[str, str]]:
    """Effective settings and, per key, where each value came from. Raises ConfigError."""
    values = {**DEFAULTS, **RESTORE_DEFAULTS, "repair_kinds": list(DEFAULT_REPAIR_KINDS)}
    source = {k: "default" for k in values}
    if not CONFIG_FILE.exists():
        stray = [str(p) for p in LEGACY_CONFIG_FILES if p.exists()]
        if stray:  # an older config we could not translate: its excludes are unknown, so sleep nothing
            raise ConfigError(f"{CONFIG_FILE} is missing but {stray[0]} exists and was not migrated "
                              "(see sleeper.log); write the plugin config by hand")
    if CONFIG_FILE.exists():
        try:
            raw = parse_toml(CONFIG_FILE)
        except Exception as exc:  # TOMLDecodeError, OSError, or the subset parser's ConfigError
            raise ConfigError(f"{CONFIG_FILE}: {exc}")
        for k, v in raw.items():
            if k == "idle":
                values["idle_hours"], source["idle_hours"] = parse_duration(v), str(CONFIG_FILE)
            elif k == "restore":
                if not isinstance(v, dict):
                    raise ConfigError(f"{CONFIG_FILE}: `restore` must be a [restore] table")
                for rk, rv in v.items():
                    if rk not in RESTORE_DEFAULTS:
                        raise ConfigError(f"{CONFIG_FILE}: unknown key {rk!r} in [restore]")
                    values[rk], source[rk] = rv, str(CONFIG_FILE)
            elif k in DEFAULTS:
                values[k], source[k] = v, str(CONFIG_FILE)
            else:
                raise ConfigError(f"{CONFIG_FILE}: unknown key {k!r}")
    env = {"idle_hours": "HERDR_SLEEPER_IDLE_HOURS", "idle": "HERDR_SLEEPER_IDLE", "exclude": "HERDR_SLEEPER_EXCLUDE",
           "agents": "HERDR_SLEEPER_AGENTS", "poll_seconds": "HERDR_SLEEPER_POLL_SECONDS",
           "notify": "HERDR_SLEEPER_NOTIFY", "wake_on_focus": "HERDR_SLEEPER_WAKE_ON_FOCUS",
           "repair_flags": "HERDR_SLEEPER_REPAIR_FLAGS", "repair_window_minutes": "HERDR_SLEEPER_REPAIR_WINDOW_MINUTES",
           "repair_kinds": "HERDR_SLEEPER_REPAIR_KINDS", "repair_bypass": "HERDR_SLEEPER_REPAIR_BYPASS",
           "require_empty_composer": "HERDR_SLEEPER_REQUIRE_EMPTY_COMPOSER"}
    if "HERDR_SLEEPER_IDLE" in os.environ and "HERDR_SLEEPER_IDLE_HOURS" in os.environ:
        raise ConfigError("set only one of HERDR_SLEEPER_IDLE and HERDR_SLEEPER_IDLE_HOURS")
    for k, var in env.items():
        if var in os.environ:
            raw_v = os.environ[var]
            key = "idle_hours" if k == "idle" else k
            values[key] = (raw_v.split() if k in ("exclude", "agents", "repair_kinds")
                           else parse_duration(raw_v) if key == "idle_hours"
                           else _env_bool(var, raw_v) if key in ("notify", "wake_on_focus", "repair_flags",
                                                                  "repair_bypass", "require_empty_composer")
                           else raw_v)
            source[key] = f"${var}"
    if source["exclude"] == "default":
        # no exclude anywhere we read, while an older config we do not read has one: "no excludes"
        # would sleep what the operator excluded (orchestrators), so sleep nothing until it is merged
        for old in LEGACY_CONFIG_FILES:
            if not old.exists() or same_dir(str(old), str(CONFIG_FILE)):
                continue
            try:
                legacy = parse_toml(old)
            except Exception as exc:
                raise ConfigError(f"{CONFIG_FILE} sets no exclude and {old} cannot be read to check for one "
                                  f"({exc}); add `exclude = [...]` (or `exclude = []`) to {CONFIG_FILE}")
            if legacy.get("exclude"):
                raise ConfigError(f"{CONFIG_FILE} sets no exclude but {old} (not read) has exclude = "
                                  f"{legacy['exclude']!r}; merge it into {CONFIG_FILE} (or set `exclude = []`) "
                                  "and delete the old file")
    # validation: a bad config must never mean "no excludes" or "sleep everything"
    for key in ("idle_hours", "poll_seconds"):
        if isinstance(values[key], bool):  # TOML `false` would otherwise become 0.0 = sleep everything
            raise ConfigError(f"{key} must be a number, not a boolean")
    try:
        values["idle_hours"] = float(values["idle_hours"])
        values["poll_seconds"] = float(values["poll_seconds"])
    except (TypeError, ValueError) as exc:
        raise ConfigError(f"idle_hours/poll_seconds must be numbers: {exc}")
    if not math.isfinite(values["idle_hours"]) or values["idle_hours"] < 0:
        raise ConfigError(f"idle_hours must be a finite number >= 0, got {values['idle_hours']!r}")
    if not (1 <= values["poll_seconds"] <= 3600):
        raise ConfigError("poll_seconds must be within 1..3600")
    for key in ("exclude", "agents", "repair_kinds"):
        v = values[key]
        if isinstance(v, str):
            v = [v]
        if not isinstance(v, list) or not all(isinstance(x, str) for x in v):
            raise ConfigError(f"{key} must be a list of strings")
        values[key] = v
    unknown = [a for a in values["agents"] if a not in PROFILES]
    if unknown:
        raise ConfigError(f"agents has unsupported kind(s) {unknown}; known: {sorted(PROFILES)}")
    unknown = [a for a in values["repair_kinds"] if a not in KINDS]
    if unknown:
        raise ConfigError(f"repair_kinds has kind(s) Herdr does not restore {unknown}; known: {sorted(KINDS)}")
    for key in ("notify", "wake_on_focus", "repair_flags", "repair_bypass", "require_empty_composer"):
        if not isinstance(values[key], bool):
            raise ConfigError(f"{key} must be a boolean")
    window = values["repair_window_minutes"]
    if isinstance(window, bool):
        raise ConfigError("repair_window_minutes must be a number, not a boolean")
    try:
        window = float(window)
    except (TypeError, ValueError) as exc:
        raise ConfigError(f"repair_window_minutes must be a number: {exc}")
    if not math.isfinite(window) or not (0 < window <= 1440):
        raise ConfigError(f"repair_window_minutes must be within 0..1440 (exclusive of 0), got {window!r}")
    values["repair_window_minutes"] = window
    return values, source


# ---------------------------------------------------------------- inspection

def transcript_for(uuid: str) -> Path | None:
    """The transcript for a claude session; when several match, the most recently written one."""
    hits = [Path(p) for p in glob.glob(str(TRANSCRIPTS / "*" / f"{uuid}.jsonl"))]
    if not hits:
        return None
    try:
        return max(hits, key=lambda p: p.stat().st_mtime)
    except OSError:
        return None


INTERPRETER = re.compile(r"^(python[\d.]*|node|bun|deno)$")


def agent_proc_args(kind: str, proc: dict) -> list[str] | None:
    """The argv after the agent's own name when this foreground process is the agent `kind`, else None.

    The agent is its binary (cursor is `cursor-agent`, not `cursor`), or a script an interpreter runs
    (`python3 …/hermes --resume ID`, `node …/claude-code/cli.js`). The launcher's own leading arguments
    are removed by normalize_argv, so the caller sees what the operator typed.
    """
    argv = [str(a) for a in (proc.get("argv") or [])]
    names = {kind, kind_binary(kind)}
    base = os.path.basename(argv[0])
    if base in names or proc.get("name") in names:
        return normalize_argv(kind, argv[1:])
    if base == "node" and any(p.endswith((f"{kind}-code/cli.js", f"{kind}/cli.js")) for p in argv[1:3]):
        return normalize_argv(kind, argv[1:])
    if INTERPRETER.match(base) and len(argv) > 1 and os.path.basename(argv[1]) in names:
        return normalize_argv(kind, argv[2:])
    return None


def normalize_argv(kind: str, args: list[str]) -> list[str]:
    """Drop what a kind's launcher puts in front of the operator's own arguments. cursor-agent is a node
    wrapper: `cursor-agent --use-system-ca …/versions/<v>/index.js --yolo --resume ID`."""
    if kind == "cursor":
        rest = list(args)
        if rest[:1] == ["--use-system-ca"]:
            rest.pop(0)
            if rest[:1] and rest[0].endswith(".js"):
                rest.pop(0)
            return rest
    return args


def agent_process(pane: str, kind: str) -> tuple[bool | None, list[str] | None, int | None]:
    """(present, argv_after_argv0, pid) for the agent process controlling the pane.

    present is True/False when process-info answered, None when it could not
    be read — an unknown must never be mistaken for "gone". A foreground
    process whose argv Herdr could not read (macOS gives a name but no argv
    for some processes) makes the answer unknown too, unless another process
    already identifies the agent.
    """
    info = herdr("pane", "process-info", "--pane", pane, check=False).get("process_info")
    if not isinstance(info, dict) or not isinstance(info.get("foreground_processes"), list):
        return None, None, None
    # an idle pane still lists its shell; [] is Herdr's "could not see the foreground job" (unwrap_or_default)
    unknown = not info["foreground_processes"]
    for proc in info["foreground_processes"]:
        if not (proc.get("argv") or []):
            unknown = True
            continue
        args = agent_proc_args(kind, proc)
        if args is not None:
            return True, args, proc.get("pid")
    return (None, None, None) if unknown else (False, None, None)


def stub_argv_index(argv: list[str]) -> int | None:
    """Index of the script token when argv is our wake stub, else None.

    Structural, never a substring test: `[python] /…/herdr-sleeper stub PANE UUID [STATE_DIR]`,
    the script as argv[0] (shebang exec) or argv[1] after a python interpreter. A claude whose
    prompt or `--add-dir` merely mentions this plugin and the word `stub` is not a stub.
    """
    for i in (0, 1):
        if i < len(argv) and os.path.basename(str(argv[i])) == "herdr-sleeper":
            if i == 1 and not os.path.basename(str(argv[0])).lower().startswith("python"):
                return None
            return i if [str(a) for a in argv[i + 1:i + 2]] == ["stub"] and len(argv) >= i + 4 else None
    return None


def stub_running(pane: str, uuid: str | None = None) -> bool | None:
    """Is our in-pane wake stub (for this pane, and this uuid when given) the pane's foreground process?

    The stub appears as `<python> /path/to/herdr-sleeper stub <pane> <uuid>`
    (a child of the pane's shell — never exec'd over the shell itself).
    None when that cannot be told (process-info unreadable, or a process without argv).
    """
    info = herdr("pane", "process-info", "--pane", pane, check=False).get("process_info")
    if not isinstance(info, dict) or not isinstance(info.get("foreground_processes"), list):
        return None
    unknown = not info["foreground_processes"]  # [] is "could not see the job", never "no stub"
    for proc in info["foreground_processes"]:
        argv = [str(a) for a in (proc.get("argv") or [])]
        if not argv:
            unknown = True
            continue
        i = stub_argv_index(argv)
        if i is not None and argv[i + 2] == pane and (uuid is None or argv[i + 3] == uuid):
            return True
    return None if unknown else False


def rss_mb(pane: str) -> int:
    """Resident memory of the pane's foreground job (the agent plus what it spawned)."""
    info = herdr("pane", "process-info", "--pane", pane, check=False).get("process_info")
    pids = [str(p.get("pid")) for p in (info or {}).get("foreground_processes", []) if p.get("pid")]
    if not pids:
        return 0
    try:
        out = subprocess.run(["ps", "-o", "rss=", "-p", ",".join(pids)], capture_output=True, text=True, timeout=10).stdout
        return sum(int(x) for x in out.split() if x.isdigit()) // 1024
    except (OSError, ValueError, subprocess.SubprocessError):
        return 0


REFUSED_OPTIONS = {"--fork-session", "--print", "--session-id", "--new", "--replay", "-p"}
BOOLEAN_OPTIONS = {"--dangerously-skip-permissions", "--verbose", "--debug", "-d"}
VALUE_OPTIONS = {"--model", "--permission-prompt-tool", "--add-dir", "--setting-source", "--env"}


def replayable_argv(args: list[str], kind: str = "claude") -> tuple[list[str] | None, str | None]:
    """Strip session-selection flags; refuse argv that would fork the session or re-run work.

    Returns (argv_to_replay, refusal_reason). Claude keeps its allow-list exactly (below). Any other kind
    in KINDS is classified by replayable_kind; a kind with no entry is never replayable.
    """
    if kind != "claude":
        return replayable_kind(kind, args)
    out: list[str] = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--":
            return None, "argv contains `--` (positional input would be replayed)"
        if a in REFUSED_OPTIONS or a.split("=", 1)[0] in REFUSED_OPTIONS:
            return None, f"argv contains {_option_name(a)} (not safely replayable)"
        if a in ("--resume", "-r"):
            if i + 1 < len(args) and not args[i + 1].startswith("-"):
                i += 1  # drop its value too
            i += 1
            continue
        if a.startswith("--resume=") or a in ("--continue", "-c"):
            i += 1
            continue
        if a in BOOLEAN_OPTIONS:
            out.append(a)
            i += 1
            continue
        base = a.split("=", 1)[0]
        if base in VALUE_OPTIONS:
            out.append(a)
            if "=" not in a:
                if i + 1 >= len(args):
                    return None, f"{_option_name(a)} is missing its value"
                out.append(args[i + 1])
                i += 1
            i += 1
            continue
        if a.startswith("-"):
            # an option we do not know the arity of: guessing could turn a prompt into a "value" and replay it
            return None, f"argv has unrecognised option {_option_name(a)} (add it to VALUE_OPTIONS/BOOLEAN_OPTIONS if it is safe)"
        return None, f"argv has positional input ({len(a)} chars; an initial prompt would be re-sent on wake)"
    return out, None


def _option_name(token: str) -> str:
    return token.split("=", 1)[0] if token.startswith("-") else token


def replayable_kind(kind: str, args: list[str]) -> tuple[list[str] | None, str | None]:
    """replayable_argv for the kinds that are not claude: the launch flags to put back, or why not.

    Fail closed, per KINDS[kind]: the kind's own resume forms are dropped (the resume tokens replace them);
    `--`, a positional argument (an initial prompt, a subcommand such as `exec` or `fork`), an option from the
    kind's refused set, a missing value and any option not in the kind's lists are refused; in "none"
    mode (the CLI was not readable on the machine this table was written on) so is anything but the resume
    tokens. A kind with no entry yields "not replayable", never a guess.
    """
    spec = KINDS.get(kind)
    if spec is None:
        return None, f"no restore recipe for agent kind {kind!r}"
    sub = spec["resume"][1] if spec["resume"][0] == "sub" else None
    out: list[str] = []
    i, seen_positional = 0, False
    while i < len(args):
        a = args[i]
        if a == "--":
            return None, "argv contains `--` (positional input would be replayed)"
        if not a.startswith("-"):
            if sub is not None and a == sub and not seen_positional:
                seen_positional = True
                i += 2 if i + 1 < len(args) and not args[i + 1].startswith("-") else 1  # the subcommand and its id
                continue
            return None, f"argv has positional input ({len(a)} chars; an initial prompt or subcommand would be re-run on wake)"
        name = _option_name(a)
        if name in spec["refused"]:
            return None, f"argv contains {_option_name(a)} (not safely replayable)"
        has_value = "=" in a
        if name in spec["strip_value"] | spec["strip_optional"] | spec["strip_named"]:
            nxt = args[i + 1] if i + 1 < len(args) else None
            if not has_value and nxt is not None and not nxt.startswith("-"):
                i += 1  # its value goes too
            i += 1
            continue
        if name in spec["strip_bare"]:
            i += 1
            continue
        if spec["mode"] == "none":
            return None, f"argv has option {_option_name(a)} and the {kind} CLI was not available to read its options (not replayable)"
        if name in spec["values"]:
            out.append(a)
            if not has_value:
                if i + 1 >= len(args):
                    return None, f"{_option_name(a)} is missing its value"
                out.append(args[i + 1])
                i += 1
            i += 1
            continue
        if name in spec["bools"]:
            out.append(a)
            i += 1
            continue
        # not listed: refuse, long or short, with or without `=value`. An unlisted `--token=...` would otherwise be
        # replayed (and its value could be a secret); a pane we cannot vouch for is left alone.
        return None, f"argv has unrecognised option {_option_name(a)} (add it to KINDS[{kind!r}] if it is safe)"
    return out, None


def selects(kind: str, argv: list[str], uuid: str) -> bool:
    """Does this argv (after the agent binary) select exactly this session with the kind's resume form?"""
    spec = KINDS.get(kind)
    if spec is None:
        return False
    if kind == "claude":
        return resumes(argv, uuid)
    wanted = resume_tokens(kind, uuid)
    if wanted is None:
        return False
    how, tok = spec["resume"]
    names = {tok, *spec["strip_value"], *spec["strip_optional"]} - spec["strip_bare"]
    if how == "sub":
        return any(argv[i:i + 2] == [tok, uuid] for i in range(len(argv)))
    if len(wanted) > 2:  # letta's default conversation: `--conversation default … --agent ID`
        return any(argv[i:i + 2] == wanted[:2] for i in range(len(argv))) and any(
            argv[i:i + 2] == wanted[2:] for i in range(len(argv)))
    for i, a in enumerate(argv):
        name, eq, val = a.partition("=")
        if name in names and (val == uuid if eq else argv[i + 1:i + 2] == [uuid]):
            return True
    return False


def composer_state(screen: str | None) -> tuple[str, str]:
    """('empty' | 'draft' | 'unknown', detail) judged from the pane screen, failing closed.

    Only consulted for kinds exited by typing into the composer (a signal exit
    discards drafts instead of submitting them). The composer is the last line
    starting with a prompt glyph; text after it, or any non-footer line below
    it, is a draft. No glyph at all, or no screen, is unknown — refuse.
    """
    if screen is None:
        return "unknown", "screen unreadable"
    lines = [ln.rstrip() for ln in screen.splitlines() if ln.strip()]
    for idx in range(len(lines) - 1, -1, -1):
        stripped = lines[idx].lstrip()
        if stripped.startswith(PROMPT_GLYPHS):
            draft = stripped[1:].strip()
            if draft:
                return "draft", f"draft present ({len(draft)} chars)"
            rest = [ln.strip() for ln in lines[idx + 1:]]
            below = [ln for ln in rest if not (ln.startswith(FOOTER_PREFIXES) or set(ln) <= {"─"})]
            if below:
                return "draft", f"draft present ({len(below[0])} chars)"
            if not rest:  # a bare glyph with nothing rendered under it is not a composer we can vouch for
                return "unknown", "no footer below the prompt"
            return "empty", ""
        if stripped.startswith(("⏺", "✻", "⎿")):
            return "unknown", "composer not visible below transcript"
    return "unknown", "no prompt glyph on screen"


COMPOSER_DETECTORS = {"claude": composer_state}


def composer_refusal(kind: str, screen: str | None, require_empty: bool = True) -> str | None:
    """Why a restore repair must wait for the input box, or None when it may go ahead.

    A signal exit discards a typed draft, so a repair looks first. Only a kind with a detector in
    COMPOSER_DETECTORS (KINDS[kind]["composer"]) has anything to look at; today that is claude, the one
    whose screen was verified on live panes. Every other kind has no reliable signal (a codex or opencode
    composer shows placeholder text a screen scrape cannot tell from a draft; a cursor pane can be showing a
    question menu while idle), so nothing is checked and the repair is not blocked: the gates that remain are
    idle/done, not focused, same terminal and session, session live nowhere else.
    With a detector: `empty` passes; `draft` always refuses; `unknown` (screen unreadable, no composer
    visible) refuses unless `[restore] require_empty_composer = false`.
    """
    detector = COMPOSER_DETECTORS.get(KINDS.get(kind, {}).get("composer") or "")
    if detector is None:
        return None
    state, detail = detector(screen)
    if state == "empty" or (state == "unknown" and not require_empty):
        return None
    return f"composer {state}: {detail}"


def uuid_live_elsewhere(uuid: str, except_pane: str | None = None, cwd: str | None = None,
                        ignore_pids: set[int] | None = None) -> str | None:
    """Where this session is already running ('pane w1:p2', 'pid 123'); None if verified nowhere.

    Raises SleeperError when that cannot be verified — an unknown answer must
    not authorise a resume, which would fork the session. `ignore_pids` names
    processes that are the session itself and about to be replaced (restore repair
    checks before it exits the pane's own agent).
    """
    try:
        agents = list_agents()
    except SleeperError as exc:
        raise SleeperError(f"cannot verify session liveness: {exc}")
    for a in agents:
        if a["pane_id"] != except_pane and (a.get("agent_session") or {}).get("value") == uuid:
            return f"pane {a['pane_id']}"
    try:
        ps = subprocess.run(["ps", "-eo", "pid=,args="], capture_output=True, text=True, timeout=15, check=True).stdout
    except (OSError, subprocess.SubprocessError) as exc:
        raise SleeperError(f"cannot verify session liveness: ps failed ({exc})")
    for line in ps.splitlines():
        parts = line.split()
        if len(parts) < 2:
            continue
        if ignore_pids and parts[0].isdigit() and int(parts[0]) in ignore_pids:
            continue
        # a shell whose command text merely mentions the uuid is not a session; anything else that
        # selects the uuid on its command line (claude, node …/claude, node …/cli.js) is treated as one
        if os.path.basename(parts[1]) in ("bash", "sh", "zsh", "fish", "dash", "login"):
            continue
        i = stub_argv_index(parts[1:])
        if i is not None and parts[i + 4:i + 5] == [uuid]:
            continue  # our own in-pane wake stub carries the uuid as an argument; it is not a session
        selects = any(p == uuid or p.endswith("=" + uuid) for p in parts[2:])
        if selects:
            return f"pid {parts[0]}"
        if not any(os.path.basename(p) == "claude" or p.endswith("claude-code/cli.js") for p in parts[1:3]):
            continue
        # `claude --continue` picks up the newest session in its cwd, which may be this one
        if cwd and any(p in ("--continue", "-c") for p in parts[2:]):
            where = process_cwd(parts[0])
            if where is None:
                raise SleeperError(f"cannot verify session liveness: pid {parts[0]} runs `claude --continue` "
                                   "and its cwd could not be inspected (lsof)")
            if where == cwd:
                return f"pid {parts[0]} (claude --continue in {cwd})"
    return None


def process_cwd(pid: str) -> str | None:
    """The process's cwd via lsof, or None when that could not be established (callers treat None as unknown)."""
    try:
        proc = subprocess.run(["lsof", "-a", "-p", pid, "-d", "cwd", "-Fn"], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    if proc.returncode != 0:
        return None
    for line in proc.stdout.splitlines():
        if line.startswith("n") and len(line) > 1:
            return line[1:]
    return None


def same_dir(a: str, b: str) -> bool:
    return os.path.realpath(a) == os.path.realpath(b)


def carries_sleep_label(info: dict) -> bool:
    return str(info.get("label") or "").startswith(SLEEP_MARK)


def identity(entry: dict, info: dict) -> str:
    """How a pane (`pane get`/`pane list`/`agent list` row) relates to a journal entry's pane.

    'same'      the terminal the entry was recorded in;
    'restarted' a new terminal id on a pane that still carries our 💤 label: Herdr
                re-allocates every terminal id on restore (src/persist/restore.rs:574) and
                re-applies the saved manual label (:577), so this is the slept pane after a
                restart. cwd is deliberately not evidence: workspace ids restart at
                max(restored)+1 (src/workspace.rs:151), so a fresh pane can get a recycled
                pane id *and* the same cwd; it never gets our label;
    'reused'    a new terminal without the label: the pane id was handed to something else;
    'unknown'   either side has no terminal id (legacy entries) — callers fail closed.
    """
    ours, now = entry.get("terminal_id"), info.get("terminal_id")
    if not ours or not now:
        return "unknown"
    if ours == now:
        return "same"
    return "restarted" if carries_sleep_label(info) else "reused"


def orphan_key(container: dict, uuid: str) -> str:
    key = "orphan:" + uuid[:8]
    if key in container and (container[key] or {}).get("uuid") != uuid:
        key += "-" + hashlib.sha1(uuid.encode()).hexdigest()[:6]
    return key


def is_orphan(key: str, entry: dict) -> bool:
    """Orphans are never auto-woken; a hand-made `orphan:` key counts whatever its phase says."""
    return (str(key).startswith("orphan:") or entry.get("phase") == "orphaned"
            or str(entry.get("pane_id") or "").startswith("orphan:"))


def orphan_entry(journal: dict, pane: str, reason: str) -> str:
    """Re-key an entry out of the pane namespace (its pane id now belongs to something else).

    Keeps every field, so `list` still prints the manual resume line; one event, then
    silence (focus hooks and reconcile look up pane ids, which an orphan key never is).
    """
    entry = journal.pop(pane)
    entry.pop("seen_running", None)
    key = orphan_key(journal, entry["uuid"])
    journal[key] = {**entry, "phase": "orphaned", "orphaned_from": pane, "orphan_reason": reason,
                    "orphaned_at": dt.datetime.now().isoformat(timespec="seconds")}
    say(f"orphaned {pane} as {key}: {reason}; resume by hand: {manual_command(entry)}")
    event("orphaned", pane=pane, key=key, name=entry.get("name"), uuid=entry["uuid"], reason=reason)
    return key


WAKING_FIELDS = ("waking_pid", "waking_at")


def waking_alive(entry: dict) -> bool | None:
    """Is the process that took a `waking` row still the stub, or the session it exec'd into?

    exec keeps the pid, so one pid covers both. True: its argv is our stub for this pane and
    uuid, or selects the uuid (the resumed agent). False: gone, or the pid now runs something
    else (reused). None: ps could not tell — callers treat that like alive (refuse, keep).
    """
    pid = entry.get("waking_pid")
    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return False  # exists, but another user's: not our stub or agent
    except OSError:
        return None
    try:
        out = subprocess.run(["ps", "-p", str(pid), "-o", "args="], capture_output=True, text=True,
                             timeout=10, check=True).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    toks = out.split()
    if not toks:
        return False
    uuid = entry.get("uuid") or ""
    i = stub_argv_index(toks)
    if i is not None:
        return toks[i + 2:i + 4] == [entry.get("pane_id"), uuid]
    return any(t == uuid or t.endswith("=" + uuid) for t in toks[1:])


def put_back(journal: dict, pane: str, row: dict, why: str) -> None:
    """Return a woken-but-not-running row to `asleep` under pane. Never `setdefault`: if the
    pane's row now names another session, ours goes to an orphan key instead of vanishing."""
    back = {k: v for k, v in row.items() if k not in WAKING_FIELDS}
    back["phase"] = "asleep"
    cur = journal.get(pane)
    if isinstance(cur, dict) and cur.get("uuid") != row["uuid"]:
        key = orphan_key(journal, row["uuid"])
        journal[key] = {**back, "phase": "orphaned", "orphaned_from": pane, "orphan_reason": why,
                        "orphaned_at": dt.datetime.now().isoformat(timespec="seconds")}
        say(f"{pane} now holds {cur.get('uuid')}; {row['uuid']} kept as {key}: {why}")
        event("orphaned", pane=pane, key=key, name=row.get("name"), uuid=row["uuid"], reason=why)
    else:
        journal[pane] = back


def is_subsequence(small: list[str], big: list[str]) -> bool:
    it = iter(big)
    return all(tok in it for tok in small)


def resumes(argv: list[str], uuid: str) -> bool:
    """Does this claude argv (after the binary) select exactly this session with --resume? (`selects` for any kind.)"""
    return any(a == f"--resume={uuid}" or (a in ("--resume", "-r") and argv[i + 1:i + 2] == [uuid])
               for i, a in enumerate(argv))


RESTORE_EVIDENCE = "same-pane+young-terminal"   # what a repair marker records once richer_record's proof held
RESTORE_ID_WINDOW_SECONDS = 600                 # Herdr restore allocates every terminal id within seconds of the server start
SERVER_START_CACHE: dict[str, object] = {"at": 0.0, "value": None, "sock": None}


def terminal_born(terminal: str | None) -> float | None:
    """The unix time embedded in a Herdr terminal id (`term_<13 hex digits: unix microseconds><counter>`,
    LESSONS 2.1), else None for an id of any other shape."""
    m = re.fullmatch(r"term_([0-9a-f]{13})[0-9a-f]*", terminal or "")
    if not m:
        return None
    born = int(m.group(1), 16) / 1e6
    return born if 1.5e9 < born < 4.1e9 else None


def process_started(pid: int) -> float | None:
    """Unix time process `pid` started (ps etime, one-second resolution), None when ps cannot say."""
    try:
        out = subprocess.run(["ps", "-o", "etime=", "-p", str(pid)], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    age = parse_etime(out)
    return None if age is None else time.time() - age


def agent_identity(pid: object) -> dict:
    """{pid, pid_started} for a restore marker; {} when the pid or its start time cannot be read (the repair
    then fails closed: it cannot tell the restore's agent from a later one)."""
    if not isinstance(pid, int) or isinstance(pid, bool):
        return {}
    started = process_started(pid)
    return {} if started is None else {"pid": pid, "pid_started": started}


def parse_etime(text: str) -> float | None:
    """ps `etime` ([[dd-]hh:]mm:ss) in seconds."""
    m = re.fullmatch(r"\s*(?:(\d+)-)?(?:(\d+):)?(\d+):(\d+)\s*", text)
    if not m:
        return None
    days, hours, minutes, seconds = (int(g or 0) for g in m.groups())
    return float(((days * 24 + hours) * 60 + minutes) * 60 + seconds)


def herdr_server_started() -> float | None:
    """Unix time the Herdr server of this session started, from the process that listens on its socket
    (HERDR_SOCKET_PATH, else the default session's); None when it cannot be told, which callers treat as no
    evidence. Cached for 5 minutes: the answer only changes when the server restarts."""
    sock = os.environ.get("HERDR_SOCKET_PATH") or str(XDG_CONFIG / "herdr" / "herdr.sock")
    cache = SERVER_START_CACHE
    if cache["sock"] == sock and cache["value"] is not None and time.monotonic() - cache["at"] < 300:
        return cache["value"]
    pids = lsof_pids(Path(sock))
    servers: list[float] = []
    for pid in sorted(pids or ()):
        try:
            out = subprocess.run(["ps", "-p", str(pid), "-o", "etime=,args="], capture_output=True, text=True,
                                 timeout=10, check=False, env={**os.environ, "LC_ALL": "C"}).stdout.split(None, 1)
        except (OSError, subprocess.SubprocessError):
            return None
        elapsed = parse_etime(out[0]) if out else None
        if elapsed is not None and len(out) == 2 and "server" in out[1].split():
            servers.append(time.time() - elapsed)
    if len(servers) != 1:  # none, or an ambiguous answer
        return None
    cache.update(at=time.monotonic(), value=servers[0], sock=sock)
    return servers[0]


def restart_evidence(terminal: str | None, seen_at: object) -> bool:
    """Is this live terminal a Herdr restore of the terminal that recorded `seen_at`? Terminal ids carry their
    creation time and a restore allocates all of them within seconds of the server's start, so: the record was
    last seen before the server started, and the live terminal was born right after it (not before, and not
    long after: a pane someone opened later is not a restore, even when its pane id was reused). Fails closed
    on anything unreadable, the server's start included."""
    born = terminal_born(terminal)
    if born is None or not isinstance(seen_at, str):
        return False
    try:
        seen = time.mktime(time.strptime(seen_at, "%Y-%m-%dT%H:%M:%S"))  # stamp() writes local time
    except (ValueError, OverflowError):
        return False
    started = herdr_server_started()
    if started is None:
        return False
    return seen < started and started - 2 <= born <= started + RESTORE_ID_WINDOW_SECONDS


def richer_record(snap: dict, uuid: str, live_argv: list[str], terminal: str | None,
                  kind: str = "claude", pane: str | None = None) -> tuple[str, dict] | None:
    """The recorded launch argv that a relaunched pane of this kind lost, as (snapshot key, row); else None.

    Herdr's restore relaunches a live agent as its binary + resume flag + id from the session ref
    alone, so every launch flag is gone (src/agent_resume.rs `plan()`; KINDS has the form per kind).
    The evidence we need, all of it, fails closed:
      * identity is the session uuid AND the pane: the record sits under the live pane's own snapshot key
        (pane numbers of a surviving workspace are never reused, LESSONS 2.2), so a bare resume of the same
        session in a new pane or tab is not mistaken for a restore (and a record kept under an `orphan:` key
        or another pane's key is never used);
      * a restart happened: the record was made in another terminal, and that terminal's id is young enough
        to be a restore: born right after the Herdr server started, while the record was last seen before
        it (restart_evidence; a changed terminal id alone proves nothing, LESSONS 2.1);
      * the live argv selects this very session and is replayable, and the record's replayable
        flags are a strict superset of the live flags (live exactly `--resume <uuid>`, or a
        strict subsequence of the recorded flags);
      * the most recent observation of this session in another terminal is the richer one. If
        a later one was bare, someone ran it bare on purpose and it stays that way.
    """
    if not terminal or not selects(kind, live_argv, uuid):
        return None
    live_extras, _why = replayable_argv(live_argv, kind)
    if live_extras is None:
        return None
    seen = [(k, r) for k, r in snap.items()
            if isinstance(r, dict) and r.get("uuid") == uuid and r.get("kind") == kind
            and r.get("terminal_id") and r["terminal_id"] != terminal and isinstance(r.get("seen_at"), str)]
    if not seen:
        return None
    key, newest = max(seen, key=lambda kr: kr[1]["seen_at"])
    if pane is None or key != pane:
        return None
    argv = newest.get("argv")
    if not isinstance(argv, list) or not all(isinstance(x, str) for x in argv):
        return None
    extras, _why = replayable_argv(argv, kind)
    if extras is None or len(extras) <= len(live_extras) or not is_subsequence(live_extras, extras):
        return None
    if not restart_evidence(terminal, newest.get("seen_at")):
        return None
    return key, newest


def merge_snapshot(agents: list[dict], repair: bool | set[str] | frozenset[str] = True) -> None:
    """pane→uuid→argv for every supported pane, merged so that panes currently asleep keep their handle.

    A pane now running a different session retires the old row: dropped when it is the same
    terminal (a deliberate replacement), kept under an `orphan:` key when the pane id was reused.

    Every kind in KINDS is recorded (not only the sleepable ones): Herdr relaunches them all bare.
    Restore repair (`repair`: True is every kind, False none, a set of kinds those): a pane that Herdr's
    restore relaunched bare must not overwrite
    the richer launch argv recorded for that session before repair_restored has used it. The pane's
    row then keeps the richer record's argv, terminal_id, seen_at and cwd (the observation it really
    is) and carries a `repair` marker for the live terminal: {terminal_id, state, first_seen, ...}.
    state is `pending` until repair_restored acts; any other state settles that terminal for good
    (at most one attempt per session and terminal), after which the live argv is recorded as it is.
    """
    snap = read_json(SNAPSHOT)
    live = {a["pane_id"]: a for a in agents}
    repair_set = set(KINDS) if repair is True else set() if repair is False else set(repair)

    def retire(pane: str) -> None:
        row = snap.pop(pane)
        if isinstance(row, dict) and row.get("uuid") and (
                not row.get("terminal_id") or row.get("terminal_id") != live[pane].get("terminal_id")):
            snap[orphan_key(snap, row["uuid"])] = {**row, "pane_id": pane, "orphaned_from": pane}

    for a in agents:
        kind = a.get("agent")
        if kind not in KINDS:
            continue
        uuid = (a.get("agent_session") or {}).get("value")
        if not uuid:
            continue
        prior = snap.get(a["pane_id"]) or {}
        if isinstance(prior, dict) and prior.get("uuid") and prior.get("uuid") != uuid:
            retire(a["pane_id"])
            prior = {}
        present, argv, pid = agent_process(a["pane_id"], kind)
        hiccup = argv is None and present is None and prior.get("uuid") == uuid
        if hiccup:
            argv = prior.get("argv")  # process-info hiccup: keep what we knew rather than erase it
        # only the replayable flags are kept: a positional prompt or a refused option's value (an --api-key=) never
        # reaches panes.json. Every reader runs replayable_argv again (idempotent on its own output); a refused
        # argv is stored as null, which every reader treats as "nothing to replay"
        kept = None if argv is None else replayable_argv(argv, kind)[0]
        row = {
            "kind": kind, "uuid": uuid, "name": a.get("name"), "cwd": a.get("cwd"),
            "title": a.get("terminal_title_stripped"), "argv": kept,
            "terminal_id": a.get("terminal_id"),
            "seen_at": stamp(),
        }
        marker = prior.get("repair")
        if not isinstance(marker, dict) or marker.get("terminal_id") != a.get("terminal_id"):
            marker = None  # bookkeeping of an older restart: this terminal gets a fresh look
        pending = marker is not None and marker.get("state") == REPAIR_PENDING
        lost = None
        repairing = kind in repair_set
        if repairing and argv is not None and not hiccup and (marker is None or pending):
            lost = richer_record(snap, uuid, argv, a.get("terminal_id"), kind, a["pane_id"])
        if lost is not None or (repairing and pending and hiccup):
            src = lost[1] if lost is not None else prior
            row.update({k: src[k] for k in ("argv", "terminal_id", "seen_at", "cwd") if src.get(k) is not None})
            row["name"] = row["name"] or src.get("name")
            if isinstance(row.get("argv"), list):  # a record an older version kept raw is rewritten filtered
                row["argv"] = replayable_argv([str(x) for x in row["argv"]], kind)[0]
            row["repair"] = marker or {"terminal_id": a.get("terminal_id"), "state": REPAIR_PENDING,
                                       "first_seen": stamp(), "first_seen_ts": time.time(),
                                       "from_terminal": src.get("terminal_id"), **agent_identity(pid)}
            if lost is not None:
                row["repair"] = {**row["repair"], "evidence": RESTORE_EVIDENCE}  # proven again on this very look
        elif marker is not None and not pending:
            row["repair"] = marker  # settled for this terminal: remembered, so it is never attempted twice
        snap[a["pane_id"]] = row
    for pane in list(snap):  # a live pane whose agent (of any kind) runs another session
        now = ((live.get(pane) or {}).get("agent_session") or {}).get("value")
        if now and isinstance(snap[pane], dict) and snap[pane].get("uuid") != now:
            retire(pane)
        row = snap.get(pane)
        if (isinstance(row, dict) and isinstance(row.get("repair"), dict) and row["repair"].get("state") == REPAIR_PENDING
                and (not now or now != row.get("uuid"))):
            row.pop("repair")  # the pane is gone (or runs something else): nothing left to repair
    write_json(SNAPSHOT, snap)


def wake_name(entry: dict) -> str:
    return entry.get("name") or "wake-" + entry["pane_id"].replace(":", "-")


# --------------------------------------------------------------- assessment

SLEEPABLE_STATUSES = {"idle", "done"}


def assess(agent: dict, all_agents: list[dict], idle_hours: float, journal: dict,
           exclude: set[str] | None = None, idle_since: float | None = None,
           allow_focused: bool = False) -> tuple[bool, str, float | None]:
    """Decide whether one agent may be slept. Returns (ok, reason, idle_hours).

    The idle clock itself lives in the watcher (seq movement); `idle_since`
    is the wall-clock start (time.time()) of this pane's current idle
    stretch. Manual `sleep-pane` passes idle_since=None to skip the window,
    and allow_focused=True: an explicit request may sleep the focused pane.
    """
    pane = agent["pane_id"]
    kind = agent.get("agent")
    if exclude and (pane in exclude or agent.get("name") in exclude):
        return False, "excluded", None
    if pane in journal:
        return False, f"already in sleep journal ({journal[pane].get('phase', 'asleep')})", None
    if kind not in PROFILES:
        return False, f"agent kind {kind!r} not supported", None
    uuid = (agent.get("agent_session") or {}).get("value")
    if not uuid:
        return False, "no session uuid (cannot resume)", None
    if not valid_session_id(uuid):
        return False, "session id has characters outside the plain-token set (refused)", None
    if not allow_focused and agent.get("focused") is not False:  # missing/None must not read as "not focused"
        return False, "pane is focused (or focus unknown)", None
    status = agent.get("agent_status")
    if status not in SLEEPABLE_STATUSES:
        return False, f"status {status}", None
    others = [a for a in all_agents if a["pane_id"] != pane and (a.get("agent_session") or {}).get("value") == uuid]
    if others:
        return False, f"session also open in {', '.join(a['pane_id'] for a in others)}", None
    if kind == "claude" and transcript_for(uuid) is None:
        return False, "no transcript on disk (nothing to resume)", None
    if idle_since is not None:
        idle = (time.time() - idle_since) / 3600
        if idle < idle_hours:
            return False, f"idle {idle:.1f}h < {idle_hours:g}h", idle
        return True, f"idle {idle:.1f}h", idle
    return True, "manual", None


def recheck(agent: dict, idle_hours: float, journal: dict, exclude: set[str],
            idle_since: float | None = None, allow_focused: bool = False) -> tuple[str | None, dict | None]:
    """Re-run every check against live state right before acting. Returns (reason_to_stop, live_agent)."""
    fresh = {a["pane_id"]: a for a in list_agents() if a.get("agent")}
    now = fresh.get(agent["pane_id"])
    if now is None:
        return "agent gone", None
    if now.get("state_change_seq") != agent.get("state_change_seq"):
        return f"state changed since scan ({agent.get('agent_status')} → {now.get('agent_status')})", now
    if (now.get("agent_session") or {}).get("value") != (agent.get("agent_session") or {}).get("value"):
        return "session changed since scan", now
    ok, reason, _ = assess(now, list(fresh.values()), idle_hours, journal, exclude, idle_since, allow_focused)
    if not ok:
        return reason, now
    if PROFILES.get(now.get("agent"), {}).get("exit") == "prompt":
        state, detail = composer_state(herdr_screen(agent["pane_id"]))
        if state != "empty":
            return f"composer {state}: {detail}", now
    return None, now


# ----------------------------------------------------------------- sidebar

def claim(pane: str, kind: str, done: bool = False) -> bool:
    """Keep the slept pane's sidebar row: report a placeholder agent we own. Best effort.

    `done` (finished, unviewed) is carried into the label so sleeping does not hide that cue.
    """
    with contextlib.suppress(SleeperError):
        herdr("pane", "report-agent", pane, "--source", CLAIM_SOURCE, "--agent", CLAIM_AGENT,
              "--state", "unknown", check=False)
        herdr("pane", "report-metadata", pane, "--source", "herdr-sleeper",
              "--display-agent", f"{kind} · sleeping" + (" · done" if done else ""), check=False)
        return herdr("pane", "get", pane, check=False).get("pane", {}).get("agent") == CLAIM_AGENT
    return False


def release(pane: str) -> None:
    """Drop the claim; must precede any agent start in the pane (a stale claim outranks detection)."""
    with contextlib.suppress(SleeperError):
        herdr("pane", "release-agent", pane, "--source", CLAIM_SOURCE, "--agent", CLAIM_AGENT, check=False)
        herdr("pane", "report-metadata", pane, "--source", "herdr-sleeper",
              "--clear-display-agent", check=False)


def claimed(entry: dict, pane_info: dict | None) -> bool:
    """Is this pane's reported agent our own placeholder?"""
    return bool(pane_info) and pane_info.get("agent") == CLAIM_AGENT


def restore_label(pane: str, entry: dict, current: str | None) -> None:
    """Put back the label the pane had before sleeping; clear our 💤 label if it had none."""
    if entry.get("label"):
        herdr("pane", "rename", pane, entry["label"], check=False)
    elif current and current.startswith(SLEEP_MARK):
        herdr("pane", "rename", pane, "--clear", check=False)  # bare `rename <pane>` is a usage error (verified)


# -------------------------------------------------------------------- sleep

def wait_agent_gone(pane: str, kind: str) -> bool:
    """After an exit request: is the agent *positively* gone? Herdr no longer lists it AND no agent process
    answers (an unreadable process-info is unknown, not gone). False after EXIT_WAIT_SECONDS."""
    deadline = time.monotonic() + EXIT_WAIT_SECONDS
    while time.monotonic() < deadline:
        time.sleep(1)
        pane_now = herdr("pane", "get", pane, check=False).get("pane")
        present, _argv, _pid = agent_process(pane, kind)
        if isinstance(pane_now, dict) and "agent" not in pane_now and present is False:
            return True
    return False


def sleep_agent(agent: dict, idle_hours: float, exclude: set[str], dry_run: bool,
                idle_since: float | None = None, allow_focused: bool = False,
                notify_enabled: bool = True) -> tuple[bool, str]:
    """Try to sleep one agent. Returns (slept, outcome). Caller holds the lock.

    allow_focused: an explicit request may sleep the focused pane (threaded
    through to the final recheck, which re-reads `focused` live); it still has
    to be idle.
    """
    pane = agent["pane_id"]
    kind = agent.get("agent")
    profile = PROFILES.get(kind)
    if profile is None:
        return False, f"agent kind {kind!r} not supported"
    uuid = (agent.get("agent_session") or {}).get("value")
    if not uuid:
        return False, "no session uuid (cannot resume)"

    replay: list[str] = []
    if profile["argv_after_binary"]:
        _present, raw_argv, _pid = agent_process(pane, kind)
        if raw_argv is None:
            return False, "could not read agent argv from pane"
        replay, why = replayable_argv(raw_argv)
        if replay is None:
            return False, why or "argv not replayable"

    journal = read_json(JOURNAL)
    held = journal.get(pane)
    if isinstance(held, dict) and held.get("uuid") != uuid:
        # sleep-pane skips assess: never write over a handle kept for another session (displaced,
        # wake_pending, waking); the same uuid (an exit-requested retry) may be rewritten
        return False, (f"refused: pane holds a kept handle for {held.get('uuid')} ({held.get('phase', 'asleep')}); "
                       "wake or resolve it first")
    if dry_run:
        stop, _ = recheck(agent, idle_hours, journal, exclude, idle_since, allow_focused)
        if stop:
            event("refused", pane=pane, name=agent.get("name"), uuid=uuid, reason=stop)
            return False, f"refused: {stop}"
        return False, "would sleep (dry run)"

    pane_info = herdr("pane", "get", pane).get("pane", {})
    label = pane_info.get("label") or None
    if label and label.startswith(SLEEP_MARK):
        label = label[len(SLEEP_MARK):] or None
    freed_mb = rss_mb(pane)
    entry = {
        "pane_id": pane, "workspace_id": agent.get("workspace_id"), "tab_id": agent.get("tab_id"),
        "terminal_id": agent.get("terminal_id") or pane_info.get("terminal_id"),
        "name": agent.get("name"), "label": label, "title": agent.get("terminal_title_stripped"),
        "cwd": agent.get("cwd"), "uuid": uuid, "kind": kind,
        "argv": replay or None, "slept_at": dt.datetime.now().isoformat(timespec="seconds"),
        "status": agent.get("agent_status"), "phase": "exit-requested",
        "stub_confirm": True,  # the stub typed below asks "Resume? [y/N]"; a record without this key has an old stub
    }
    name = wake_name(entry)

    # 1. journal first, under the lock, re-read: if anything below fails the handle still exists.
    journal = read_json(JOURNAL)
    journal[pane] = entry
    write_json(JOURNAL, journal)

    # 2. the last look before acting — after the journal write, so nothing happens between
    #    check and act but the exit itself. Targets the pane id: names can be renamed under us.
    stop, _ = recheck(agent, idle_hours, {k: v for k, v in journal.items() if k != pane}, exclude, idle_since,
                      allow_focused)
    if stop:
        journal = read_json(JOURNAL)
        journal.pop(pane, None)
        write_json(JOURNAL, journal)
        event("refused", pane=pane, name=name, uuid=uuid, reason=stop)
        return False, f"refused: {stop}"

    # 3. the exit itself. A signal discards composer drafts instead of submitting them;
    #    a typed command is only used for kinds whose composer we positively verified empty.
    how = "signal"
    if profile["exit"] == "signal":
        present, _argv, pid = agent_process(pane, kind)
        if present is not True or not pid:
            journal = read_json(JOURNAL)
            journal.pop(pane, None)
            write_json(JOURNAL, journal)
            event("refused", pane=pane, name=name, uuid=uuid, reason="agent process not identifiable for signal")
            return False, "refused: agent process not identifiable for signal"
        freed_mb = freed_mb or rss_mb(pane)
        try:
            os.kill(int(pid), signal.SIGTERM)
        except (OSError, ValueError) as exc:
            journal = read_json(JOURNAL)
            journal.pop(pane, None)
            write_json(JOURNAL, journal)
            event("refused", pane=pane, name=name, uuid=uuid, reason=f"signal failed: {exc}")
            return False, f"refused: signal failed: {exc}"
        how = f"SIGTERM to pid {pid}"
    else:
        herdr("agent", "prompt", pane, profile["exit_command"], check=False)
        how = f"typed {profile['exit_command']!r}"

    # 4. "gone" needs positive evidence: Herdr no longer lists the agent AND no agent process.
    if not wait_agent_gone(pane, kind):
        # A timeout is not proof the exit failed; keep the handle and let the next tick reconcile.
        say(f"WARN {pane}: agent still present {EXIT_WAIT_SECONDS}s after exit; entry kept as exit-requested")
        event("exit-uncertain", pane=pane, name=name, uuid=uuid)
        return False, "exit uncertain; will reconcile next tick"

    journal = read_json(JOURNAL)
    if pane in journal:
        journal[pane]["phase"] = "asleep"
        write_json(JOURNAL, journal)

    # 5. reset terminal modes, claim the sidebar row, leave the wake stub, mark the label, notify.
    #    The stub runs as a child of the pane's shell (no `exec` — the shell must survive beneath
    #    it, or the pane would close when the woken agent exits). The pane shell has none of the
    #    plugin env, so the typed command carries the stub's own routing (see stub_command).
    herdr("pane", "run", pane, stub_command(pane, uuid, entry["slept_at"]), check=False)
    herdr("pane", "rename", pane, SLEEP_MARK + (label or entry["title"] or name), check=False)
    time.sleep(2)  # herdr takes ~2s to drop the exited agent's session; the claim is ignored before that
    claim(pane, kind, done=entry["status"] == "done")
    event("slept", pane=pane, name=name, uuid=uuid, kind=kind, title=entry["title"], cwd=entry["cwd"],
          freed_mb=freed_mb or None, how=how)
    notify(f"{SLEEP_MARK}slept {name}", f"freed ~{freed_mb} MB · wake: answer y in the pane, or "
            f"{shlex.join([str(SELF), 'wake', name])}", enabled=notify_enabled)
    return True, "slept"


# ------------------------------------------------------------------- stub

def stub_command(pane: str, uuid: str, slept_at: str) -> str:
    """The line typed into a slept pane's shell: reset modes, a banner, then the wake stub.

    POSIX-shell text with no control bytes (escapes are printf's), and `env` for the
    routing — the session's socket, the herdr binary, the session name — so it does not
    depend on the shell's assignment-prefix syntax. HERDR_CLIENT_SOCKET_PATH is left
    out: the CLI routes by HERDR_SOCKET_PATH (src/session.rs), and an inherited client
    socket could belong to an outer session.
    """
    if not valid_session_id(uuid):
        raise SleeperError("refusing to type a stub line for a session id that is not a plain token")
    env_args = [f"{var}={os.environ[var]}" for var in ("HERDR_SOCKET_PATH", "HERDR_BIN_PATH") if os.environ.get(var)]
    env_args.append(f"HERDR_SESSION={SESSION}")
    banner = SLEEP_MARK + "slept by herdr-sleeper " + slept_at
    return (f"printf '{MODE_RESET_PRINTF}'; clear; printf '%s\\n' {shlex.quote(banner)}; "
            + shlex.join(["env", *env_args, str(SELF), "stub", pane, uuid, str(STATE_DIR)]))


def set_state_dir(state_dir: Path) -> None:
    """Point every state path at state_dir (the stub inherits no plugin env; the sleep side types it)."""
    global STATE_DIR, JOURNAL, SNAPSHOT, EVENTS, LOGFILE, LOCK, WATCHER_PID, WATCHER_LOCK, IDLE_FILE
    STATE_DIR = state_dir
    JOURNAL, SNAPSHOT, EVENTS = STATE_DIR / "sleeping.json", STATE_DIR / "panes.json", STATE_DIR / "events.jsonl"
    LOGFILE, LOCK, WATCHER_PID = STATE_DIR / "sleeper.log", STATE_DIR / "lock", STATE_DIR / "watcher.pid"
    WATCHER_LOCK, IDLE_FILE = STATE_DIR / "watcher.lock", STATE_DIR / "idle.json"


STUB_MARK_RETRY_SECONDS = 600   # how long a stub keeps trying to mark its row while it waits for an answer
STUB_MARK_ATTEMPT_SECONDS = 5   # one attempt waits this long for the global lock


def mark_stub_row(pane: str, uuid: str, timeout: float | None = None) -> tuple[str, dict | None]:
    """Mark the stub's journal row `stub_confirm` (this stub only takes `y`; a stub of an older version never
    marks, which is how wake_entry tells them apart). Returns (state, row): `marked` (row after), `busy` (the
    global lock stayed taken for `timeout`: try again), `gone` (the row is not this session's any more, or the
    journal is damaged: stop trying)."""
    try:
        with locked(timeout=STUB_MARK_ATTEMPT_SECONDS if timeout is None else timeout):
            journal = read_json(JOURNAL)
            cur = journal.get(pane) or {}
            if cur.get("uuid") != uuid:
                return "gone", None
            if not cur.get("stub_confirm"):
                journal[pane] = cur = {**cur, "stub_confirm": True}
                write_json(JOURNAL, journal)
            return "marked", cur
    except DamagedState:
        return "gone", None
    except SleeperError:
        return "busy", None


def keep_marking_stub_row(pane: str, uuid: str, stop: threading.Event,
                          seconds: float = STUB_MARK_RETRY_SECONDS) -> threading.Thread:
    """Retry mark_stub_row in a daemon thread until it lands, the row is gone, `stop` is set (the prompt was
    answered) or `seconds` pass. A watcher still on old code holds the global lock for a whole tick, across
    every pane that is due (seconds to half a minute each), so one 5 s attempt can lose to it; the stub sits
    in input() meanwhile and an answer needs the mark, so it keeps asking."""
    def run() -> None:
        deadline = time.monotonic() + seconds
        while not stop.is_set() and time.monotonic() < deadline:
            state, _row = mark_stub_row(pane, uuid)
            if state != "busy":
                return

    thread = threading.Thread(target=run, name="stub-mark", daemon=True)
    thread.start()
    return thread


def cmd_stub(pane: str, uuid: str, state_dir: str | None = None) -> int:
    """The in-pane wake stub: asks "Resume? [y/N]", and on `y`/`Y` + Enter execs the agent back into its session.

    Runs inside the pane's shell with none of the plugin env; the sleep side
    therefore types the routing (socket, session, state dir) into the command
    line itself. Only `y` or `Y` on a line is a wake request: a bare Enter (what
    send-keys and orchestrators deliver by accident), stray text and any other
    answer leave the pane asleep, with the hint re-printed at most once. Ctrl-C or
    EOF leaves a plain shell and prints the manual resume command.

    The hint also names `herdr-sleeper wake`, because Herdr's restore replays the
    saved screen history after a restart while no stub runs: the printed text must
    still make sense then (LESSONS 2.5).

    The journal row is never popped here. Under the lock, after the last
    checks (liveness included), it becomes `waking` with this pid — exec keeps
    the pid, so it names the resumed agent afterwards. Every other wake path
    refuses a `waking` row whose pid is alive; reconcile drops it once the
    session is seen running in the pane (and gives the agent its name back),
    or puts it back to `asleep` if the pid died first. Anything that stops us
    before the exec (ctrl-c, a failed Herdr call, the exec itself) puts it back
    at once.
    """
    global HERDR_BIN
    HERDR_BIN = os.environ.get("HERDR_BIN_PATH") or "herdr"
    if state_dir:
        set_state_dir(Path(state_dir))
    journal = read_json(JOURNAL)
    entry = journal.get(pane) or {}
    if entry.get("uuid") != uuid:
        print(f"herdr-sleeper: no journal entry for {uuid} in {pane}; type `exit` or start an agent by hand")
        return 0
    kind = entry.get("kind") or "claude"
    name = wake_name(entry)
    title = entry.get("title")
    who = f"{name} · {title}" if title and title != name else name
    who = "".join(c for c in who if c.isprintable())  # the title is set by whatever ran in the pane: no CR/ESC spoofing
    # This stub's prompt only takes `y`, but the row may have been written by an older watcher (still on old code
    # until `startup`), whose wake sends a bare Enter. The stub is the authority on what it accepts, so it marks
    # its own row. The first attempt is made before the prompt is shown; if the lock stays busy (that watcher is
    # mid-tick) a thread keeps trying while the stub waits in input(), and stops once the prompt is answered.
    marking = threading.Event()
    state, marked = mark_stub_row(pane, uuid)
    if marked is not None:
        entry = marked
    elif state == "busy":
        keep_marking_stub_row(pane, uuid, marking)
    print(f"\n  slept {entry.get('slept_at', '?')}. Prompt not answering (for example after a Herdr restart)? "
          f"Run: {shlex.join([str(SELF), 'wake', name])}")
    print(f"  {SLEEP_MARK}Sleeping: {who}. Resume? [y/N] ", end="", flush=True)
    hinted = False
    try:
        while True:
            try:
                line = input().strip()
            except (EOFError, KeyboardInterrupt, OSError, UnicodeError, RuntimeError):  # last three: hung-up pty, bad bytes, no stdin
                release(pane)
                print(f"left as a shell; resume with: {manual_command(entry)}")
                return 0
            if line in ("y", "Y"):
                break
            if not hinted:  # once: the first stray line is explained, the rest are ignored silently
                hinted = True
                seen = f"ignored {line[:60]!r}; " if line else ""
                print(f"herdr-sleeper: {seen}staying asleep. Type y then Enter to resume, ctrl-c for a plain shell.")
    finally:
        marking.set()  # answered (or gone): the marker thread, if one runs, stops asking for the lock

    def refuse(why: str, drop_claim: bool = False) -> int:
        if drop_claim:
            release(pane)
        print(f"herdr-sleeper: {why}; left asleep.\n  manual: {manual_command(entry)}")
        return 0

    binary = shutil.which(kind)
    if not binary:
        return refuse(f"`{kind}` is not on this shell's PATH (use `herdr-sleeper wake`: "
                      "Herdr starts it with its own environment)")
    extra: list[str] = []
    if PROFILES.get(kind, {}).get("argv_after_binary"):
        if entry.get("argv") is None:
            return refuse("original argv unknown; refusing to invent one")
        extra, why = replayable_argv(entry["argv"])  # a crash-recovered snapshot argv was never vetted
        if extra is None:
            return refuse(why or "argv not replayable")
    argv = resume_argv(kind, uuid, extra or None)
    if argv is None:
        return refuse(f"no resume recipe for {kind}", drop_claim=True)
    if kind == "claude" and transcript_for(uuid) is None:
        return refuse(f"the transcript for {uuid} is gone (nothing to resume)")
    if entry.get("cwd") and not same_dir(os.getcwd(), entry["cwd"]):
        return refuse(f"pane cwd is {os.getcwd()}, slept-in {entry['cwd']}", drop_claim=True)
    with locked():
        journal = read_json(JOURNAL)
        cur = journal.get(pane) or {}
        if cur.get("uuid") != uuid or cur.get("phase", "asleep") != "asleep":
            print("herdr-sleeper: the journal entry changed while waiting (woken elsewhere?); left as a shell")
            return 0
        where = uuid_live_elsewhere(uuid, except_pane=pane, cwd=cur.get("cwd"))  # raises when it cannot tell
        if where:
            print(f"herdr-sleeper: session is already live in {where}; left as a shell.\n"
                  f"  manual: {manual_command(cur)}")
            return 0
        journal[pane] = {**cur, "phase": "waking", "waking_pid": os.getpid(),
                         "waking_at": dt.datetime.now().isoformat(timespec="seconds")}
        write_json(JOURNAL, journal)
    try:
        release(pane)  # must precede the agent: a stale claim outranks detection
        restore_label(pane, cur, (herdr("pane", "get", pane, check=False).get("pane") or {}).get("label"))
        event("woke", pane=pane, name=name, uuid=uuid, via="stub", slept_at=cur.get("slept_at"))
        # drop typeahead: a `y`+Enter that `wake` typed while this stub waited on the lock must not reach the agent
        with contextlib.suppress(Exception):
            termios.tcflush(sys.stdin.fileno(), termios.TCIFLUSH)
        os.execvp(binary, [kind, *argv])
    except (Exception, KeyboardInterrupt) as exc:  # anything before the exec took: the row goes back at once
        with locked():
            journal = read_json(JOURNAL)
            put_back(journal, pane, cur, f"stub could not start {binary}: {exc!r}")
            write_json(JOURNAL, journal)
        claim(pane, kind, done=cur.get("status") == "done")
        herdr("pane", "rename", pane, SLEEP_MARK + (cur.get("label") or cur.get("title") or name), check=False)
        event("wake-failed", pane=pane, name=name, uuid=uuid, via="stub", reason=repr(exc))
        print(f"herdr-sleeper: could not start {binary} ({exc!r}); left asleep.\n  manual: {manual_command(cur)}")
        return 1
    return 0  # unreachable in production: execvp replaces the process


# ------------------------------------------------------------------- wake

DELEGATED = "delegated"  # wake_entry: `y` + Enter went to the pane's own stub; the caller confirms outside the lock


def wake_entry(entry: dict, via: str = "command", key: str | None = None) -> bool | str:
    """Wake one journaled pane via `agent start`. Caller holds the lock; the entry is persisted.

    `key` is the journal key when the caller has it: an `orphan:` key makes the entry an
    orphan whatever its body says. Returns True (woken), False (refused or failed; the entry
    is kept, re-keyed, or settling), or DELEGATED when the pane's stub was asked to do it
    (see await_stub_wake).
    """
    if not valid_entry(entry):
        raise SleeperError(f"malformed journal entry: {json.dumps(entry)[:120]}")
    pane = entry["pane_id"]
    name = wake_name(entry)
    uuid = entry["uuid"]
    kind = entry["kind"]
    if is_orphan(key or pane, entry):
        say(f"cannot wake {name}: orphaned (its pane id was reused); resume by hand: {manual_command(entry)}")
        return False
    if entry.get("phase") == "displaced":
        say(f"cannot wake {name}: its pane now holds session {entry.get('wake_got')}; recover by hand: {manual_command(entry)}")
        return False
    if entry.get("phase") == "waking":
        alive = waking_alive(entry)
        if alive is not False:  # the stub (or the agent it became) is on it; reconcile settles the row
            say(f"cannot wake {name}: a wake is already in progress in {pane} (pid {entry.get('waking_pid')}"
                f"{'' if alive else ', not verifiable'}); entry kept")
            return False
        entry = {k: v for k, v in entry.items() if k not in WAKING_FIELDS}  # the stub died: an asleep row
    extra: list[str] = []
    if PROFILES.get(kind, {}).get("argv_after_binary") or entry.get("restore_repair"):
        if entry.get("argv") is None:
            say(f"cannot wake {name}: original argv unknown; refusing to invent one. Manual: {manual_command(entry)}")
            return False
        extra, why = replayable_argv(entry["argv"], kind)
        if extra is None:
            say(f"cannot wake {name}: {why}; entry kept. Manual: {manual_command(entry)}")
            return False
    argv = resume_argv(kind, uuid, extra or None)
    if argv is None:
        say(f"cannot wake {name}: no resume recipe for {kind}; entry kept. Manual: {manual_command(entry)}")
        return False
    pane_info = herdr("pane", "get", pane, check=False).get("pane")
    if not pane_info:
        say(f"cannot wake {name}: pane {pane} no longer exists; entry kept. Manual: {manual_command(entry)}")
        return False
    if claimed(entry, pane_info):
        release(pane)  # our own placeholder; the real checks below run on the shell left behind
        pane_info = herdr("pane", "get", pane, check=False).get("pane") or {}
    ident = identity(entry, pane_info)
    if "agent" in pane_info and pane_info.get("agent") != CLAIM_AGENT:
        running = (pane_info.get("agent_session") or {}).get("value")
        if running == uuid and agent_process(pane, kind)[0] is True:
            if entry.get("phase") == "exit-requested":
                # one sighting could be Herdr lagging a slow exit; reconcile's two-sighting rule decides
                say(f"{name}: exit still settling in {pane}; leaving the entry to reconcile")
                return False
            say(f"{name}: session {uuid} is already running in {pane}; clearing journal entry")
            restore_label(pane, entry, pane_info.get("label"))
            journal = read_json(JOURNAL)
            journal.pop(pane, None)
            write_json(JOURNAL, journal)
            return True
        if running and running != uuid and ident != "same" and not (entry.get("wake_got") or entry.get("wake_pending")):
            journal = read_json(JOURNAL)
            if pane in journal:
                orphan_entry(journal, pane, f"pane id now runs session {running} in another terminal")
                write_json(JOURNAL, journal)
            return False
        say(f"cannot wake {name}: pane {pane} still shows an agent (session {running}); entry kept")
        return False
    if ident == "unknown" and not carries_sleep_label(pane_info):
        # a legacy entry with no terminal id on record: our 💤 label is the only pane evidence left
        ident = "reused"
    if ident == "reused":
        journal = read_json(JOURNAL)
        if pane in journal:
            orphan_entry(journal, pane, f"pane id now belongs to terminal {pane_info.get('terminal_id')} "
                                        f"in {pane_info.get('cwd')}, which does not carry the sleep label")
            write_json(JOURNAL, journal)
        return False
    if agent_process(pane, kind)[0] is not False:
        say(f"cannot wake {name}: cannot confirm pane {pane} is at a bare shell; entry kept")
        return False
    restamp: str | None = None
    if ident == "restarted":
        # Herdr re-allocates terminal ids on restore and re-applies our 💤 label: the same pane. The
        # new id is written only with the pop below — a refused wake must not adopt this terminal.
        restamp = pane_info["terminal_id"]
        say(f"{name}: identity re-established after a Herdr restart (terminal {entry['terminal_id']} -> "
            f"{restamp}, pane still labelled {SLEEP_MARK.strip()})")
        entry = {**entry, "terminal_id": restamp}
    if entry.get("cwd") and pane_info.get("cwd") and not same_dir(pane_info["cwd"], entry["cwd"]):
        # a precondition, not identity evidence: the shell moved; the pane is still ours
        say(f"cannot wake {name}: pane {pane} now lives in {pane_info['cwd']}, journal says {entry['cwd']} "
            f"(cd back, or resume by hand); entry kept. Manual: {manual_command(entry)}")
        event("wake-refused", pane=pane, name=name, uuid=uuid, reason="cwd mismatch")
        return False
    where = uuid_live_elsewhere(uuid, cwd=entry.get("cwd"))  # raises when it cannot tell
    if where:
        say(f"cannot wake {name}: session {uuid} is already live in {where}")
        event("wake-refused", pane=pane, name=name, uuid=uuid, reason=f"live in {where}")
        return False
    if kind == "claude" and transcript_for(uuid) is None:
        say(f"cannot wake {name}: transcript for {uuid} is gone; entry kept. Manual: {manual_command(entry)}")
        return False
    stub = stub_running(pane, uuid)
    if stub is None:
        say(f"cannot wake {name}: cannot tell whether the wake stub runs in {pane}; entry kept")
        return False
    if stub:
        # answer the stub's "Resume? [y/N]": it does the exec-wake. A stub left by an older version (its record has
        # no `stub_confirm`) wakes on a bare Enter and would only ignore the "y" line, so it gets the old keys.
        herdr("pane", "send-keys", pane, *(("y", "enter") if entry.get("stub_confirm") else ("enter",)), check=False)
        return DELEGATED

    def start(agent_name: str) -> dict:
        return herdr("agent", "start", agent_name, "--kind", kind, "--pane", pane, "--timeout", str(WAKE_TIMEOUT_MS),
                     "--", *argv, timeout=WAKE_TIMEOUT_MS / 1000 + 30)

    result: dict | None = None
    failure = ""
    try:
        result = start(name)
    except SleeperError as exc:
        failure = str(exc)
    fallback = "wake-" + pane.replace(":", "-")
    if result is None and "agent_name_taken" in failure and name != fallback:
        # the name went to another agent while this one slept; one retry under the pane's own name
        say(f"wake {name}: the name is taken now; starting it as {fallback}")
        try:
            result, name = start(fallback), fallback
        except SleeperError as exc:
            failure = str(exc)
    if result is None:
        say(f"wake {name} failed: {failure}; entry kept")
        event("wake-failed", pane=pane, name=name, uuid=uuid, reason=failure)
        return False
    got = ((result.get("agent") or {}).get("agent_session") or {}).get("value")
    for _ in range(WAKE_CONFIRM_SECONDS if got is None else 0):
        time.sleep(1)  # `agent start` can return before the agent reports its session
        got = ((herdr("pane", "get", pane, check=False).get("pane") or {}).get("agent_session") or {}).get("value")
        if got:
            break
    journal = read_json(JOURNAL)
    if got is None:
        if pane in journal:
            journal[pane].update(wake_pending=True, wake_started_at=dt.datetime.now().isoformat(timespec="seconds"),
                                 **({"terminal_id": restamp} if restamp else {}))  # our start runs in this terminal
            write_json(JOURNAL, journal)
        say(f"{name}: started in {pane}, but no session reported within {WAKE_CONFIRM_SECONDS}s; entry kept "
            f"for reconcile (running {uuid} -> dropped after two sightings; anything else -> displaced)")
        event("wake-unconfirmed", pane=pane, name=name, uuid=uuid)
        return False
    if got != uuid:
        # a fresh session took the pane; keep the record so the old one stays reachable.
        if pane in journal:
            journal[pane].update(wake_failed_at=dt.datetime.now().isoformat(timespec="seconds"), wake_got=got,
                                 **({"terminal_id": restamp} if restamp else {}))
            write_json(JOURNAL, journal)
        say(f"WARN {name}: pane now runs session {got}, expected {uuid}; entry kept. Manual: {manual_command(entry)}")
        event("wake-mismatch", pane=pane, name=name, uuid=uuid, got=got)
        return False
    restore_label(pane, entry, pane_info.get("label"))
    journal.pop(pane, None)
    write_json(JOURNAL, journal)
    say(f"woke {name} in {pane} uuid={got} (via {via})")
    if via == "repair":  # restore repair: one event per repair, whose second half this wake is
        event("repaired", pane=pane, name=name, uuid=got, kind=kind, flags=flag_names(extra), terminal=entry.get("terminal_id"),
              from_terminal=entry.get("repair_from_terminal"))
    else:
        event("woke", pane=pane, name=name, uuid=got, kind=kind, via=via, slept_at=entry.get("slept_at"))
    return True


def give_name_back(pane: str, entry: dict, live_name: str | None) -> None:
    """A stub-woken agent is detected unnamed: hand it the name it slept with (best effort, logged)."""
    want = entry.get("name")
    if not want or live_name == want:
        return
    try:
        herdr("agent", "rename", pane, want)
    except SleeperError as exc:
        say(f"WARN {pane}: could not give the name {want!r} back to the resumed agent ({exc})")


def finish_waking(pane: str, uuid: str, live_name: str | None) -> bool:
    """The session a stub resumed is running in its pane: drop the `waking` row, name the agent.
    Takes the lock; returns whether a row was finished."""
    with locked():
        journal = read_json(JOURNAL)
        row = journal.get(pane)
        if not isinstance(row, dict) or row.get("uuid") != uuid:
            return False
        journal.pop(pane)
        write_json(JOURNAL, journal)
    give_name_back(pane, row, live_name)
    event("reconciled", pane=pane, name=wake_name(row), uuid=uuid, outcome="woken")
    return True


def await_stub_wake(entry: dict) -> bool:
    """After `y` + Enter went to the pane's stub: did the session come back? Called without the lock (the stub needs it).

    A stub that exec'd but whose session Herdr has not reported yet (a slow claude start) is
    "started", not a failure: its row is `waking` and its pid is alive; reconcile finishes it.
    """
    pane, uuid, name = entry["pane_id"], entry["uuid"], wake_name(entry)
    for _ in range(WAKE_DELEGATE_SECONDS):
        info = herdr("pane", "get", pane, check=False).get("pane") or {}
        if (info.get("agent_session") or {}).get("value") == uuid:
            finish_waking(pane, uuid, info.get("agent_name") or info.get("name"))
            say(f"woke {name} in {pane} uuid={uuid} (via stub)")
            return True
        time.sleep(1)
    row = read_json(JOURNAL).get(pane) or {}
    if row.get("uuid") == uuid and row.get("phase") == "waking" and waking_alive(row):
        say(f"wake {name}: the stub started {uuid} in {pane}; session not yet reported after "
            f"{WAKE_DELEGATE_SECONDS}s (reconcile finishes it)")
        event("wake-started", pane=pane, name=name, uuid=uuid, via="stub")
        return True
    say(f"wake {name}: the pane's stub did not resume {uuid} within {WAKE_DELEGATE_SECONDS}s "
        "(it prints why in the pane); entry kept")
    event("wake-delegated-unconfirmed", pane=pane, name=name, uuid=uuid)
    return False


def find_journal_entry(target: str | None) -> tuple[str, dict, bool] | None:
    """The entry named by a pane id, wake name, or agent name: (pane, entry, from_snapshot).

    A pane id (or orphan key) matches exactly. A name matching more than one entry
    raises SleeperError with the candidates rather than picking one. No target
    matches nothing (an unnamed entry must not match a missing name).
    """
    if not target:
        return None
    journal = read_json(JOURNAL)
    if isinstance(journal.get(target), dict):
        return target, journal[target], False
    hits = sorted((p, e) for p, e in journal.items()
                  if valid_entry(e) and target in (wake_name(e), e.get("name") or None))
    if len(hits) > 1:
        raise SleeperError(f"{target!r} names {len(hits)} sleeping agents ({', '.join(p for p, _ in hits)}); "
                           "name the pane id instead")
    if hits:
        return hits[0][0], hits[0][1], False
    snap = read_json(SNAPSHOT)
    for p, s in snap.items():
        if isinstance(s, dict) and s.get("kind") in PROFILES and target in (
                p, s.get("name"), "wake-" + p.replace(":", "-")):  # only a kind that can sleep has a wake handle
            rec = {"pane_id": p, **s, "phase": "orphaned" if p.startswith("orphan:") else "asleep",
                   "slept_at": None, "label": None, "tab_id": None, "workspace_id": None}
            rec.pop("repair", None)  # the snapshot's restore-repair marker, not a journal field
            return p, rec, True
    return None


def cmd_wake(args: argparse.Namespace) -> int:
    target = args.target
    if not args.all and not target:
        target = context_pane()  # the pane action passes no argument: it means "this pane"
        if not target:
            print("no pane context; pass a pane id, wake name, or agent name", file=sys.stderr)
            return 2
    delegated: list[dict] = []
    with locked():
        try:
            journal = read_json(JOURNAL)
        except DamagedState as exc:
            if args.all:
                raise
            aside = quarantine(JOURNAL)  # keep the damaged bytes; recovery below writes a fresh journal
            say(f"WARN {exc}; damaged journal moved to {aside}; continuing with snapshot recovery only")
            journal = {}
        if args.all:
            targets = [e for k, e in journal.items()
                       if isinstance(e, dict) and e.get("phase") != "displaced" and not is_orphan(k, e)]
            if not targets:
                held = len(journal)
                print("nothing is sleeping" + (f" ({held} orphaned/displaced: see `list`)" if held else ""))
                return 0
        else:
            try:
                hit = find_journal_entry(target)
            except DamagedState as exc:
                aside = quarantine(JOURNAL)  # keep the damaged bytes; snapshot recovery writes a fresh journal
                say(f"WARN {exc}; damaged journal moved to {aside}; continuing with snapshot recovery only")
                hit = find_journal_entry(target)
            except SleeperError as exc:
                print(f"{exc}", file=sys.stderr)
                return 1
            if not hit:
                print(f"no sleeping agent named {target!r}; try `herdr-sleeper list`")
                return 1
            if is_orphan(hit[0], hit[1]):  # the key decides, whatever pane id the body names
                print(f"{hit[0]} is orphaned (its pane id was reused); never woken automatically.\n"
                      f"  manual: {manual_command(hit[1])}")
                return 1
            if hit[2]:  # crash recovery: persist the recovered entry *before* trying, or a
                journal = read_json(JOURNAL)  # mid-wake crash loses the only other copy of the handle
                journal[hit[0]] = hit[1]
                write_json(JOURNAL, journal)
                print(f"recovering {hit[0]} from panes.json")
            targets = [hit[1]]
        woke = 0
        for entry in targets:
            try:
                outcome = wake_entry(entry, via="command", key=None if args.all else hit[0])
            except SleeperError as exc:
                say(f"wake {wake_name(entry)}: {exc}")
                continue
            if outcome == DELEGATED:
                delegated.append(entry)
            elif outcome:
                woke += 1
    for entry in delegated:  # outside the lock: the stub takes it to pop its row
        woke += await_stub_wake(entry)
    print(f"woke {woke}/{len(targets)}")
    return 0 if woke == len(targets) else 1


# --------------------------------------------------------------- reconcile

def reconcile(agents: list[dict]) -> None:
    """Settle `exit-requested` entries, displaced sessions, reused pane ids, and panes that moved."""
    journal = read_json(JOURNAL)
    by_pane = {a["pane_id"]: a for a in agents if a.get("agent")}  # a listed pane with no agent is not live
    panes = {}
    with contextlib.suppress(SleeperError):
        panes = {p.get("pane_id"): p for p in herdr("pane", "list").get("panes", [])}
    changed = False
    for pane, entry in list(journal.items()):
        live = by_pane.get(pane)
        live_uuid = ((live or {}).get("agent_session") or {}).get("value")
        if not valid_entry(entry):
            say(f"reconcile {pane}: malformed journal entry left untouched")
            continue
        if is_orphan(pane, entry):
            continue  # not bound to a pane any more: by hand only
        kind = entry["kind"]
        if entry.get("phase") == "waking":
            # a stub took this row and exec'd (or is about to): finish it once the session is seen
            # running here; back to asleep if its process died first; displaced if another session came
            if live and live_uuid == entry["uuid"] and agent_process(pane, kind)[0] is True:
                journal.pop(pane)
                changed = True
                give_name_back(pane, entry, live.get("name"))
                event("reconciled", pane=pane, name=wake_name(entry), uuid=entry["uuid"], outcome="woken")
            elif live and live_uuid and live_uuid != entry["uuid"]:
                entry.update(phase="displaced", wake_got=live_uuid)
                for k in WAKING_FIELDS:
                    entry.pop(k, None)
                changed = True
                say(f"reconcile {pane}: the stub's wake of {entry['uuid']} left {live_uuid} there; entry kept "
                    f"for manual recovery: {manual_command(entry)}")
            elif not live and waking_alive(entry) is False:
                put_back(journal, pane, entry, "the waking stub exited before its session appeared")
                changed = True
                claim(pane, kind, done=entry.get("status") == "done")
                event("reconciled", pane=pane, name=wake_name(entry), uuid=entry["uuid"], outcome="asleep-again")
            continue
        confirmed_running = bool(live and live_uuid == entry["uuid"] and agent_process(pane, kind)[0] is True)
        if not confirmed_running and entry.get("seen_running"):
            entry.pop("seen_running")  # the streak must be consecutive; anything unconfirmed resets it
            changed = True
        if confirmed_running:
            # seen running with a real process. Once could be Herdr lagging a slow exit; twice in a row is not.
            seen = int(entry.get("seen_running", 0)) + 1
            if seen < 2:
                entry["seen_running"] = seen
                changed = True
                continue
            say(f"reconcile {pane}: session {entry['uuid']} is running again (seen twice); dropping journal entry")
            event("reconciled", pane=pane, name=wake_name(entry), uuid=entry["uuid"], outcome="running")
            journal.pop(pane)
            changed = True
        elif live and live_uuid and live_uuid != entry["uuid"] and (entry.get("wake_got") or entry.get("wake_pending")):
            if entry.get("phase") != "displaced":
                entry["phase"] = "displaced"  # our own wake put another session here; keep the handle, by hand only
                changed = True
                say(f"reconcile {pane}: session {entry['uuid']} displaced by {live_uuid}; entry kept for manual "
                    f"recovery: {manual_command(entry)}")
        elif live and live_uuid and live_uuid != entry["uuid"]:
            if identity(entry, live) == "same":  # the same terminal: someone deliberately started another session
                say(f"reconcile {pane}: now runs session {live_uuid}, not {entry['uuid']}; dropping journal entry")
                event("reconciled", pane=pane, name=wake_name(entry), uuid=entry["uuid"], outcome="replaced",
                      by=live_uuid)
                journal.pop(pane)
            else:  # another terminal (or one we cannot prove is ours): a reused pane id; keep the handle
                orphan_entry(journal, pane, f"pane id now runs session {live_uuid} in another terminal")
            changed = True
        elif entry.get("phase") == "exit-requested" and not live and agent_process(pane, kind)[0] is False:
            entry["phase"] = "asleep"
            entry.pop("seen_running", None)
            event("reconciled", pane=pane, name=wake_name(entry), uuid=entry["uuid"], outcome="asleep")
            changed = True
        elif not live and entry.get("terminal_id"):
            # pane gone or moved: follow a terminal that still exists under a new pane id, else keep the handle
            moved = next((p for p, info in panes.items() if info.get("terminal_id") == entry["terminal_id"]
                          and p != pane and p not in journal), None)
            if moved:
                journal[moved] = {**entry, "pane_id": moved}
                journal.pop(pane)
                changed = True
                say(f"reconcile: {pane} moved to {moved} (terminal {entry['terminal_id']})")
            elif pane in panes and identity(entry, panes[pane]) == "reused":
                orphan_entry(journal, pane, f"pane id now belongs to terminal {panes[pane].get('terminal_id')} "
                                            f"in {panes[pane].get('cwd')}")
                changed = True
    if changed:
        write_json(JOURNAL, journal)


# ---------------------------------------------------------- restore repair
#
# Herdr's native agent restore (src/app/agent_resume.rs `plan()`) rebuilds a live agent's argv from the
# persisted session ref alone ({agent, kind, value} per pane), so after a server restart (reboot,
# `herdr update`) every claude pane comes back as plain `claude --resume <uuid>`: no
# --dangerously-skip-permissions, no --model, nothing. Slept panes are not affected (wake replays the
# journaled argv); live ones are, and nothing can set launch flags after the fact except starting the
# process again. So the watcher does that once per (session, terminal): merge_snapshot notices the loss
# (the pane's row keeps the richer argv recorded before the restart and carries a `repair` marker), and
# repair_restored relaunches the pane the way a sleep followed by a wake would, under the same gates.
#
# Claude only (PROFILES[kind]["argv_after_binary"]): opencode's launch flags are never recorded here and
# codex has no profile, so there is nothing richer to restore for them.
#
# Cost: a repair is a second `claude --resume` (two transcript replays). Cheaper than the native restore
# being wrong, and the only way to get the flags back.

REPAIR_PENDING = "pending"
REPAIR_IDLE_DWELL_SECONDS = 60     # a restored agent must sit idle/done this long (one state_change_seq) before repair acts

# Kinds that restore repair covers only when `repair_kinds` names them. codex: its TUI does not restore the
# terminal's keyboard protocol after a signal (the reason it never joined PROFILES), repair types no reset
# before the new start, and no codex relaunch has been seen working. Every other kind is covered by default.
REPAIR_OPT_IN = ("codex",)
DEFAULT_REPAIR_KINDS = [k for k in KINDS if k not in REPAIR_OPT_IN]


def repair_kinds(config: dict) -> set[str]:
    """The agent kinds restore repair covers: none when `[restore] repair_flags` is off, otherwise
    `repair_kinds` (default: every kind in KINDS except REPAIR_OPT_IN). Independent of `agents`, which only
    says what may be put to sleep. A config without the keys (a hand-built dict) counts as off."""
    if not config.get("repair_flags"):
        return set()
    kinds = config.get("repair_kinds")
    return {k for k in (DEFAULT_REPAIR_KINDS if kinds is None else kinds) if k in KINDS}


def repair_enabled(config: dict) -> bool:
    return bool(repair_kinds(config))


def repair_marker(row: object) -> dict | None:
    marker = row.get("repair") if isinstance(row, dict) else None
    return marker if isinstance(marker, dict) else None


def set_repair_state(pane: str, uuid: str, terminal: str | None, state: str, **fields: object) -> None:
    """Record where a repair stands in the pane's snapshot row. Caller holds the lock. A no-op when the row
    is not (or no longer) the one for this session and terminal."""
    snap = read_json(SNAPSHOT)
    row = snap.get(pane)
    marker = repair_marker(row)
    if marker is None or row.get("uuid") != uuid or marker.get("terminal_id") != terminal:
        return
    marker.update(state=state, at=stamp(), **fields)
    write_json(SNAPSHOT, snap)


def repair_gate(now: dict | None, scan: dict, agents: list[dict], row: dict, rec_extras: list[str],
                journal: dict, config: dict | None = None) -> tuple[str | None, int | None]:
    """The wake gates for a repair, against live state: (reason_to_wait, pid_of_the_agent).

    Same fail-closed rules as sleeping then waking, for whatever kind the row records: pane not focused,
    agent idle or done, nothing changed since the scan, session not open anywhere else (panes and
    processes), the transcript on disk (claude, the one kind whose transcript path we know), the pane
    back in the directory it was recorded in, the agent process identifiable with a pid, and the input
    box (composer_refusal: a signal exit discards a draft; only a kind with a detector, today claude, is
    looked at, and its `unknown` refuses unless `[restore] require_empty_composer = false`). A kind with no
    detector therefore goes on exactly this: the marker's restore evidence (richer_record: the record under
    this very pane, the terminal born right after the server started, the record last seen before it) and an
    agent that is idle or done and unfocused. Raises SleeperError when liveness cannot be verified (the
    caller treats that as a wait, never as a go).
    """
    if now is None:
        return "agent gone", None
    pane, uuid, kind = scan["pane_id"], row["uuid"], row.get("kind") or "claude"
    if now.get("state_change_seq") != scan.get("state_change_seq"):
        return f"state changed since scan ({scan.get('agent_status')} -> {now.get('agent_status')})", None
    if now.get("terminal_id") != scan.get("terminal_id") or (now.get("agent_session") or {}).get("value") != uuid:
        return "terminal or session changed since scan", None
    if kind not in KINDS or now.get("agent") != kind:
        return f"agent kind {now.get('agent')!r} is not the recorded {kind!r}, or has no launch flags to restore", None
    if (repair_marker(row) or {}).get("evidence") != RESTORE_EVIDENCE:
        # the marker was made without richer_record's proof that this terminal is a Herdr restore of the pane
        # (an older version's, or edited by hand): merge_snapshot proves it again on its next look
        return "no proof that Herdr's restore relaunched this pane (waiting for the next look)", None
    if config and (pane in (config.get("exclude") or ()) or now.get("name") in (config.get("exclude") or ())):
        return "excluded", None
    if now.get("focused") is not False:  # missing/None must not read as "not focused"
        return "pane is focused (or focus unknown)", None
    if now.get("agent_status") not in SLEEPABLE_STATUSES:
        return f"status {now.get('agent_status')}", None
    others = [a for a in agents if a["pane_id"] != pane and (a.get("agent_session") or {}).get("value") == uuid]
    if others:
        return f"session also open in {', '.join(a['pane_id'] for a in others)}", None
    if pane in journal or any(isinstance(e, dict) and e.get("uuid") == uuid for e in journal.values()):
        return "the sleep journal holds this pane or session (reconcile settles it first)", None
    if not row.get("cwd") or not now.get("cwd") or not same_dir(now["cwd"], row["cwd"]):
        return f"pane cwd is {now.get('cwd')}, recorded {row.get('cwd')} (cd back)", None
    if kind == "claude" and transcript_for(uuid) is None:
        return "no transcript on disk (nothing to resume)", None
    present, live_argv, pid = agent_process(pane, kind)
    if present is not True or not isinstance(pid, int) or isinstance(pid, bool):
        return "agent process not identifiable for signal", None
    if pid != (repair_marker(row) or {}).get("pid"):
        return "the agent process is not the one recorded when the restore was noticed", None
    live_extras, _why = replayable_argv(live_argv or [], kind)
    if (live_extras is None or not selects(kind, live_argv or [], uuid) or len(live_extras) >= len(rec_extras)
            or not is_subsequence(live_extras, rec_extras)):
        return "pane no longer runs a bare relaunch of the recorded flags", None
    if KINDS[kind]["composer"]:  # the screen is only read for a kind that has a detector
        refusal = composer_refusal(kind, herdr_screen(pane), (config or {}).get("require_empty_composer", True))
        if refusal:
            return refusal, None
    where = uuid_live_elsewhere(uuid, except_pane=pane, cwd=row.get("cwd"), ignore_pids={pid})
    if where:
        return f"session live in {where}", None
    return None, pid


def repair_dwell(agent: dict, marker: dict, uuid: str, terminal: str | None) -> tuple[str | None, bool]:
    """(reason to keep waiting or None once repair may act, whether the marker was settled for good).
    Writes the marker; caller holds the lock.

    Herdr's restore launch and an operator's own bare `claude --resume` look identical, and the status turns idle
    moments after either. Two guards:
    * the agent's pid and start time were recorded when the marker was made (merge_snapshot, the restore's own
      launch); if the pane's agent now has another pid or start time, the pane was relaunched since (by the
      operator; or the agent re-exec'd): the marker is settled `relaunched` and nothing is repaired. A marker
      with no recorded identity, or a pid that cannot be read now, is not repaired (fail closed).
    * the agent must stay idle or done, through one unchanged `state_change_seq`, for REPAIR_IDLE_DWELL_SECONDS.
    Not caught: an operator relaunch before the marker was made, which no signal tells apart."""
    pane, kind = agent["pane_id"], agent.get("agent")
    pid0, started0 = marker.get("pid"), marker.get("pid_started")
    if not isinstance(pid0, int) or isinstance(pid0, bool) or not isinstance(started0, (int, float)):
        return "agent pid was not recorded when the restore was noticed (not repaired)", False
    present, _argv, pid = agent_process(pane, kind)
    if present is not True or not isinstance(pid, int) or isinstance(pid, bool):
        return "agent process not identifiable for signal", False
    started = process_started(pid)
    if started is None:
        return "agent start time not readable (not repaired)", False
    if pid != pid0 or abs(started - started0) > 5:
        set_repair_state(pane, uuid, terminal, "relaunched", reason="the agent process changed after the restore")
        event("repair-settled", pane=pane, name=agent.get("name"), uuid=uuid, kind=kind,
              reason="the agent process is not the one the restore started (relaunched since)")
        return "the agent process is not the restore's (relaunched since): left alone", True
    seq, now = agent.get("state_change_seq"), time.time()
    since = marker.get("dwell_since_ts")
    if marker.get("dwell_seq") != seq or not isinstance(since, (int, float)) or isinstance(since, bool):
        set_repair_state(pane, uuid, terminal, REPAIR_PENDING, dwell_seq=seq, dwell_since_ts=now)
        since = now
    if now - since < REPAIR_IDLE_DWELL_SECONDS:
        return f"waiting for {REPAIR_IDLE_DWELL_SECONDS}s of idle", False
    return None, False


def skipped_names(row: dict, kind: str) -> list[str]:
    """Names of the bypass-class options in the row's recorded argv (for the log line only)."""
    flags, _why = replayable_argv(row.get("argv") or [], kind)
    return without_bypass(kind, flags or [])[1]


def without_bypass(kind: str, extras: list[str]) -> tuple[list[str], list[str]]:
    """(extras without the options KINDS marks `bypass` and their values, the names dropped)."""
    bypass = KINDS[kind]["bypass"]
    takes_value = VALUE_OPTIONS if kind == "claude" else KINDS[kind]["values"]
    out: list[str] = []
    dropped: list[str] = []
    i = 0
    while i < len(extras):
        tok = extras[i]
        name = _option_name(tok)
        if tok.startswith("-") and name in bypass:
            dropped.append(name)
            i += 2 if "=" not in tok and name in takes_value else 1
            continue
        out.append(tok)
        i += 1
    return out, dropped


def repair_agent(agent: dict, agents: list[dict], row: dict, config: dict) -> tuple[bool, str]:
    """Relaunch one bare-restored pane (any kind in KINDS) with its recorded flags. Caller holds the lock.

    Returns (attempted, detail). attempted=False means a gate said wait: nothing was touched and a later
    tick tries again. attempted=True means the exit was requested: the session and terminal are settled
    (never a second attempt), whatever the outcome.

    The order is sleep_agent's then wake_entry's: journal record first (phase exit-requested, so a crash
    anywhere after leaves a handle that reconcile and `herdr-sleeper wake` can finish), a last look at live state,
    SIGTERM to the identified agent process, positive evidence that it is gone, and then wake_entry itself
    starts the agent again under the same name, with the manual pane label put back, and finishes the
    record only once the start succeeded (LESSONS 2.3).
    """
    pane, uuid, terminal = agent["pane_id"], row["uuid"], agent.get("terminal_id")
    kind = row.get("kind") or "claude"
    marker = repair_marker(row) or {}
    rec_extras, why = replayable_argv(row.get("argv") or [], kind)
    if rec_extras and not config.get("repair_bypass"):
        rec_extras, skipped = without_bypass(kind, rec_extras)
        if not rec_extras and skipped:
            return False, (f"only permission/sandbox-bypass flags ({' '.join(skipped)}) were recorded; "
                           "`[restore] repair_bypass = true` re-adds them")
    if not rec_extras:
        return False, f"recorded argv not replayable: {why or 'it carries no flags'}"
    reason, _pid = repair_gate(agent, agent, agents, row, rec_extras, read_json(JOURNAL), config)
    if reason:
        return False, reason

    pane_info = herdr("pane", "get", pane).get("pane", {})
    name = agent.get("name") or row.get("name")
    entry = {
        "pane_id": pane, "workspace_id": agent.get("workspace_id"), "tab_id": agent.get("tab_id"),
        "terminal_id": terminal, "name": name, "label": pane_info.get("label") or None,
        "title": agent.get("terminal_title_stripped"), "cwd": agent.get("cwd"), "uuid": uuid, "kind": kind,
        "argv": rec_extras, "slept_at": stamp(),
        "status": agent.get("agent_status"), "phase": "exit-requested",
        "restore_repair": True, "repair_from_terminal": marker.get("from_terminal"),
    }
    label = f"{name or wake_name(entry)} ({pane})"

    # 1. journal first, re-read under the lock: if anything below fails the handle still exists
    journal = read_json(JOURNAL)
    journal[pane] = entry
    write_json(JOURNAL, journal)

    def withdraw() -> None:
        j = read_json(JOURNAL)
        j.pop(pane, None)
        write_json(JOURNAL, j)

    # 2. the last look before acting, after the journal write
    fresh = list_agents()
    now = next((a for a in fresh if a["pane_id"] == pane and a.get("agent")), None)
    try:
        reason, pid = repair_gate(now, agent, fresh, row, rec_extras, {k: v for k, v in journal.items() if k != pane},
                                  config)
    except SleeperError:
        withdraw()
        raise
    if reason or pid is None:
        withdraw()
        return False, reason or "agent process not identifiable for signal"

    # 3. from here on this session in this terminal is settled; a crash or a failure never repeats it
    set_repair_state(pane, uuid, terminal, "repairing")
    try:
        os.kill(pid, signal.SIGTERM)
    except (OSError, ValueError) as exc:
        withdraw()
        set_repair_state(pane, uuid, terminal, REPAIR_PENDING, reason=f"signal failed: {exc}")
        return False, f"signal failed: {exc}"
    say(f"repair {label}: relaunching {kind} with {shlex.join(flag_names(rec_extras))} (Herdr's restore dropped them)"
        + ("" if config.get("repair_bypass") or not skipped_names(row, kind) else
           f"; left out (repair_bypass is off): {shlex.join(skipped_names(row, kind))}"))

    # 4. positive evidence that it is gone, then the wake half
    if not wait_agent_gone(pane, kind):
        say(f"WARN {pane}: agent still present {EXIT_WAIT_SECONDS}s after exit; repair entry kept as exit-requested")
        event("repair-failed", pane=pane, name=name, uuid=uuid, kind=kind, reason="exit uncertain")
        set_repair_state(pane, uuid, terminal, "failed", reason="exit uncertain")
        return True, "exit uncertain; will reconcile next tick"
    journal = read_json(JOURNAL)
    if pane not in journal:
        set_repair_state(pane, uuid, terminal, "failed", reason="journal entry vanished")
        return True, "journal entry vanished"
    journal[pane]["phase"] = "asleep"
    write_json(JOURNAL, journal)
    try:
        outcome = wake_entry(journal[pane], via="repair")
    except SleeperError as exc:
        say(f"repair {label}: {exc}")
        outcome = False
    if outcome is True:
        set_repair_state(pane, uuid, terminal, "repaired")
        notify(f"🔧 restored flags for {name or pane}", "relaunched with " + shlex.join(flag_names(rec_extras)),
               enabled=config["notify"])
        return True, "repaired"
    event("repair-failed", pane=pane, name=name, uuid=uuid, kind=kind,
          reason="the wake half did not complete (entry kept)")
    set_repair_state(pane, uuid, terminal, "failed", reason="the wake half did not complete")
    return True, "relaunch failed; entry kept; wake it with `herdr-sleeper wake <name>` or the sidebar"


def repair_restored(agents: list[dict], config: dict) -> set[str]:
    """One watcher pass of restore repair; caller holds the lock. Returns the panes it touched (their
    entries in `agents` are stale afterwards).

    A live pane of a covered kind (repair_kinds) is a candidate when its snapshot row carries a pending `repair` marker for its current
    terminal (merge_snapshot sets it: the session was recorded with richer flags in another terminal, so
    Herdr's restore relaunched it bare). Each tick it either passes every gate and is relaunched, or waits
    with the reason logged once per change. repair_window_minutes after it was first noticed it is given up
    on, with a log line and an event. A pane is attempted at most once per session and terminal; a pane
    the operator started bare by hand therefore gets one repair, then is left alone.
    """
    snap = read_json(SNAPSHOT)
    window = config["repair_window_minutes"] * 60
    kinds = repair_kinds(config)
    touched: set[str] = set()
    for agent in agents:
        if STOP["requested"]:
            break  # a stopping watcher starts no new transaction
        pane, kind = agent["pane_id"], agent.get("agent")
        row = snap.get(pane)
        marker = repair_marker(row)
        uuid = (agent.get("agent_session") or {}).get("value")
        excluded = config.get("exclude") or ()
        if pane in excluded or agent.get("name") in excluded:
            continue  # the operator's exclude list keeps a pane out of repair exactly as it keeps it out of sleep
        if (marker is None or marker.get("state") != REPAIR_PENDING or kind not in kinds
                or row.get("kind") != kind or row.get("uuid") != uuid or marker.get("terminal_id") != agent.get("terminal_id")):
            continue
        first = marker.get("first_seen_ts")
        if isinstance(first, (int, float)) and not isinstance(first, bool) and math.isfinite(first):
            waited = time.time() - first
        else:
            waited = window + 1  # an unreadable start is a window we cannot vouch for
        if waited > window:
            say(f"repair {pane}: gave up after {config['repair_window_minutes']:g} min; last reason: "
                f"{marker.get('reason') or 'none'}. Flags by hand: {manual_command(row)}")
            event("repair-gave-up", pane=pane, name=agent.get("name"), uuid=uuid, kind=kind, reason=marker.get("reason"))
            set_repair_state(pane, uuid, agent.get("terminal_id"), "gave-up")
            LAST_SKIP.pop("repair:" + pane, None)
            continue
        try:
            wait, settled = ((None, False) if agent.get("agent_status") not in SLEEPABLE_STATUSES
                             else repair_dwell(agent, marker, uuid, agent.get("terminal_id")))
            if settled:
                LAST_SKIP.pop("repair:" + pane, None)
                continue  # the marker is settled `relaunched`: nothing more to write or try
            if wait:
                attempted, detail = False, wait
            else:
                attempted, detail = repair_agent(agent, agents, row, config)
        except SleeperError as exc:  # liveness unverifiable, a Herdr call failed: wait, never go
            attempted, detail = False, f"error: {exc}"
        except Exception as exc:  # noqa: BLE001 - a bug that only this pane's data triggers costs this pane
            attempted, detail = False, f"error: {type(exc).__name__}: {exc}"
        if attempted:
            touched.add(pane)
            LAST_SKIP.pop("repair:" + pane, None)
        else:
            note_skip("repair:" + pane, detail)
            if marker.get("reason") != detail:
                set_repair_state(pane, uuid, agent.get("terminal_id"), REPAIR_PENDING, reason=detail)
    return touched


def pending_repairs() -> list[tuple[str, dict, dict]]:
    """Snapshot rows whose restore repair is waiting or was interrupted: (pane, row, marker)."""
    try:
        snap = read_json(SNAPSHOT)
    except SleeperError:
        return []
    return sorted(((p, r, repair_marker(r)) for p, r in snap.items()
                   if not p.startswith("orphan:") and repair_marker(r)
                   and repair_marker(r).get("state") in (REPAIR_PENDING, "repairing")), key=lambda t: t[0])


# ---------------------------------------------------------------- watcher

STOP = {"requested": False}   # set by SIGTERM: finish the current transaction, then exit
QUIET_OUTCOMES = ("idle ", "excluded", "already", "status ", "agent kind", "pane is focused")
LAST_SKIP: dict[str, str] = {}  # pane -> last logged skip reason (log changes, not every tick)


def code_stamp() -> str:
    st = SELF.stat()
    return f"{st.st_mtime_ns}:{st.st_size}"


WATCH_LOCK_FD_ENV = "HERDR_SLEEPER_WATCH_LOCK_FD"   # set across a self-reload only: the fd that still holds watcher.lock


SMOKE_SECONDS = 15


def ends_with_main_guard(source: str) -> bool:
    """Is the last top-level statement of this source the `if __name__ == "__main__":` block? A file cut at a
    statement boundary compiles but lacks it (an empty file and a prefix both compile)."""
    top = [ln for ln in source.splitlines() if ln and not ln[0].isspace() and not ln.startswith("#")]
    return bool(top) and re.match(r"""if\s+__name__\s*==\s*["']__main__["']\s*:\s*(#.*)?$""", top[-1]) is not None


def smoke_problem(script: Path | None = None) -> str | None:
    """Run the new script's read-only `version` command once: None when it starts, imports and exits 0 within
    SMOKE_SECONDS, else why not. A script that compiles but cannot start (a bad import, a missing name) must
    not replace a working watcher: nothing would respawn anything better than the same crash."""
    env = {k: v for k, v in os.environ.items() if k != WATCH_LOCK_FD_ENV}
    try:
        proc = subprocess.run([sys.executable, str(script or SELF), "version"], capture_output=True, text=True,
                              timeout=SMOKE_SECONDS, stdin=subprocess.DEVNULL, env=env, check=False)
    except subprocess.TimeoutExpired:
        return f"`version` did not finish within {SMOKE_SECONDS}s"
    except OSError as exc:
        return f"could not run it ({exc})"
    if proc.returncode != 0:
        tail = (proc.stderr.strip().splitlines() or [""])[-1][:160]
        return f"`version` exited {proc.returncode}" + (f": {tail}" if tail else "")
    return None


class ReloadCheck:
    """The watcher's look at its own script, once per tick: what to do about the file on disk.

    `look()` returns (verdict, detail):
      same        the stamp is the one the loaded code was read at; carry on
      gone        the script was deleted or cannot be read; keep the code already loaded
      settling    a new stamp that the previous look did not already see: a deploy may still be writing. Only the
                  same stamp on two consecutive looks (one tick apart) is judged at all
      incomplete  not a complete Python file: it does not compile, or does not end with the `__main__` block
                  (an empty file or a file cut at a statement boundary compiles); wait for a complete one
      unrunnable  complete, but `version` run on it fails or hangs (smoke_problem); keep the loaded code
      reload      a complete, runnable new version: detail is its stamp
    A stamp is judged once (the verdict is remembered), so a failing smoke run is not repeated every tick.
    """

    def __init__(self, started: str) -> None:
        self.started = started
        self.seen: str | None = None                   # the changed stamp the previous look saw
        self.judged: dict[str, tuple[str, str]] = {}   # stamp -> final verdict

    def look(self) -> tuple[str, str]:
        try:
            now = code_stamp()
        except OSError:
            self.seen = None
            return "gone", str(SELF)
        if now == self.started:
            self.seen = None
            return "same", now
        if now != self.seen:
            self.seen = now
            return "settling", now
        if now not in self.judged:
            self.judged[now] = self.judge(now)
        return self.judged[now]

    @staticmethod
    def judge(now: str) -> tuple[str, str]:
        try:
            source = SELF.read_bytes()  # bytes: compile() honours the coding line; no locale decoding to fail under LC_CTYPE=C
            compile(source, str(SELF), "exec")
        except Exception as exc:  # noqa: BLE001 - SyntaxError, ValueError (NUL bytes), OSError
            return "incomplete", f"{now} ({type(exc).__name__})"
        if not ends_with_main_guard(source.decode("utf-8", errors="replace")):
            return "incomplete", f"{now} (does not end with the __main__ block)"
        problem = smoke_problem()
        if problem:
            return "unrunnable", f"{now} ({problem})"
        return "reload", now


def reload_watcher(lock_fh: object, started: str, now: str) -> None:
    """Replace this process with a fresh `watch` of the script on disk. Returns only when the exec failed.

    The watcher lock is handed over, not released: the fd is made inheritable and named in the environment,
    so the same open file description (and with it the flock) survives the exec and the new image adopts it
    (take_watcher_lock). Releasing first would leave a gap in which a `heal_watcher` from any plugin
    activity sees no lock holder and spawns a second watcher. The pid stays the same, so watcher.pid keeps
    pointing at the right process while the new image rewrites it.
    """
    say(f"watcher code changed on disk ({started} -> {now}); re-executing to load it")
    fd = lock_fh.fileno()  # type: ignore[attr-defined]
    os.set_inheritable(fd, True)
    os.environ[WATCH_LOCK_FD_ENV] = str(fd)
    try:
        os.execv(sys.executable, [sys.executable, str(SELF), "watch"])
    except OSError as exc:
        os.environ.pop(WATCH_LOCK_FD_ENV, None)
        os.set_inheritable(fd, False)
        say(f"WARN re-exec of the changed watcher failed ({exc}); keeping the old code")


def take_watcher_lock() -> object | None:
    """The open watcher.lock with its flock held, or None when another watcher keeps it for 2 minutes.

    A watcher that re-executed itself passes the held lock on through WATCH_LOCK_FD_ENV: the fd is adopted
    only when it is the lock file (same device and inode) and the flock can be (re-)taken on it. Anything
    else falls back to the normal wait, which also covers an old watcher finishing its last transaction.
    """
    inherited = os.environ.pop(WATCH_LOCK_FD_ENV, None)  # popped: no child of ours ever sees it
    if inherited and inherited.isdigit():
        fd = int(inherited)
        try:
            same = os.fstat(fd), os.stat(WATCHER_LOCK)
            if (same[0].st_dev, same[0].st_ino) == (same[1].st_dev, same[1].st_ino):
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)  # held already by this open file description: a no-op
                os.set_inheritable(fd, False)
                return os.fdopen(fd, "a+")
        except OSError:
            pass
    ensure_state_dir()
    lock_fh = WATCHER_LOCK.open("a+")
    for waited in range(WATCHER_LOCK_WAIT_SECONDS + 1):  # an old watcher may be finishing a transaction
        try:
            fcntl.flock(lock_fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return lock_fh
        except OSError:
            if waited == WATCHER_LOCK_WAIT_SECONDS:
                lock_fh.close()
                return None
            time.sleep(1)
    return None


def watcher_script(tokens: list[str]) -> str | None:
    """The script path when these ps tokens are exactly `[python] SCRIPT watch` with SCRIPT named herdr-sleeper,
    else None. Structural (script as argv[0], or argv[1] / argv[2] behind a python interpreter and at most one
    option), never a substring test, so `cargo watch`, an editor with the file open or `herdr-sleeper list` do
    not match."""
    for i in (0, 1, 2):
        if i < len(tokens) and os.path.basename(tokens[i]) == "herdr-sleeper":
            interpreter_ok = i == 0 or os.path.basename(tokens[0]).lower().startswith("python") and (
                i == 1 or tokens[1].startswith("-"))
            return tokens[i] if interpreter_ok and tokens[i + 1:] == ["watch"] else None
    return None


LSOF = "/usr/sbin/lsof"


def lsof_pids(path: Path) -> set[int] | None:
    """The pids that have `path` open (`lsof -t -- PATH`), or None when lsof could not answer (callers fail
    closed). lsof exits 1 with no output for a file nobody has open: that is an answer, the empty set."""
    try:
        proc = subprocess.run([LSOF if os.access(LSOF, os.X_OK) else "lsof", "-t", "--", str(path)],
                              capture_output=True, text=True, timeout=15, check=False)
    except (OSError, subprocess.SubprocessError):
        return None
    if proc.returncode not in (0, 1):
        return None
    return {int(t) for t in proc.stdout.split() if t.isdigit()}


def state_dir_watchers() -> set[int] | None:
    """The pids of the watcher(s) serving THIS state dir, or None when that cannot be told.

    Whoever has watcher.lock open (every v0.1.1+ watcher holds it for its whole life), plus the pid
    watcher.pid names when that record predates the lock (v0.1.0, no `lock` flag: nothing for lsof to see).
    A `lock: true` record adds nothing: a pid that does not hold the lock may be a reused pid that now runs
    another session's watcher (the rule watcher_alive applies). None when lsof failed: the caller kills nothing.
    """
    holders = lsof_pids(WATCHER_LOCK)
    if holders is None:
        return None
    rec = watcher_pid_record()
    if rec and isinstance(rec.get("pid"), int) and not isinstance(rec["pid"], bool) and not rec.get("lock"):
        holders.add(rec["pid"])
    return holders


def stray_watchers(ps_output: str | None = None, uid: int | None = None,
                   serving: set[int] | None = None) -> list[tuple[int, str]]:
    """Other `herdr-sleeper watch` processes that serve THIS state dir, run by this user, and whose script
    path is not SELF: [(pid, script)].

    A watcher of another Herdr session may legitimately run another copy of the plugin (a lab session, a
    checkout under test), and one per state dir is the rule, so scope is the state dir: `serving` is
    state_dir_watchers() (given for tests). Candidates are those pids intersected with the structural argv
    match of `ps -axo pid=,uid=,command=` (or the given text). When lsof cannot say who serves this state dir
    nothing is a stray. A relative script path is left alone: its working directory is unknown, so it cannot
    be told from SELF. Our own pid and our parent's are never listed.
    """
    if ps_output is None:
        try:
            ps_output = subprocess.run(["ps", "-axo", "pid=,uid=,command="], capture_output=True, text=True,
                                      timeout=15, check=True).stdout
        except (OSError, subprocess.SubprocessError):
            return []
    if serving is None:
        serving = state_dir_watchers()
        if serving is None:
            say("WARN lsof could not say which processes hold watcher.lock; stopping no other watcher")
            return []
    me = os.getuid() if uid is None else uid
    mine = {os.getpid(), os.getppid()}
    found: list[tuple[int, str]] = []
    for line in ps_output.splitlines():
        parts = line.split()
        if len(parts) < 3 or not parts[0].isdigit() or not parts[1].isdigit() or int(parts[1]) != me:
            continue
        script = watcher_script(parts[2:])
        if script is None or int(parts[0]) in mine or int(parts[0]) not in serving or not os.path.isabs(script):
            continue
        if os.path.realpath(script) != str(SELF):
            found.append((int(parts[0]), script))
    return found


STRAY_WAIT_SECONDS = 10


def stop_stray_watchers() -> list[int]:
    """SIGTERM every stray_watchers() process (a watcher of this state dir running another copy of the plugin)
    and wait for it to go (no SIGKILL: a watcher finishes its transaction first). Each one is logged.
    Returns the pids that signalled. Never raises."""
    stopped: list[int] = []
    try:
        for pid, script in stray_watchers():
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError as exc:
                say(f"WARN could not stop stray watcher pid={pid} ({script}): {exc}")
                continue
            stopped.append(pid)
            say(f"stopping stray watcher pid={pid} running {script} (this plugin is {SELF})")
            event("stray-watcher-stopped", pid=pid, script=script)
        deadline = time.monotonic() + STRAY_WAIT_SECONDS
        for pid in stopped:
            while time.monotonic() < deadline:
                try:
                    os.kill(pid, 0)
                except OSError:
                    break
                time.sleep(0.5)
            else:
                say(f"WARN stray watcher pid={pid} still running after {STRAY_WAIT_SECONDS}s; left to finish its transaction")
    except Exception as exc:  # noqa: BLE001 - the scan is housekeeping; startup must still ensure the watcher
        say(f"WARN stray watcher scan failed: {exc}")
    return stopped


def watcher_pid_record() -> dict | None:
    try:
        data = json.loads(WATCHER_PID.read_text())
        return data if isinstance(data, dict) and data.get("pid") else None
    except (OSError, ValueError):
        return None


def process_is_watcher(pid: int) -> bool:
    """Does pid run `… herdr-sleeper watch`? Matched as argv tokens, so a reused pid running
    `cargo watch` or `fswatch` is not taken for the watcher (and never gets our SIGTERM)."""
    try:
        out = subprocess.run(["ps", "-p", str(pid), "-o", "args="], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    toks = out.split()
    return any(os.path.basename(t) == "herdr-sleeper" and toks[i + 1:i + 2] == ["watch"] for i, t in enumerate(toks))


def watcher_alive(rec: dict | None) -> bool:
    """Is the recorded watcher alive? pid alive and argv `… herdr-sleeper watch`; for a record a
    v0.1.1+ watcher wrote (`lock: true`), also holding watcher.lock — a reused pid that happens
    to be another session's watcher must not pass for ours (nor receive our SIGTERM)."""
    if not rec or not isinstance(rec.get("pid"), int):
        return False
    try:
        os.kill(rec["pid"], 0)
    except OSError:
        return False
    if not process_is_watcher(rec["pid"]):
        return False
    return watcher_lock_held() if rec.get("lock") else True


def watcher_lock_held() -> bool:
    """Is a watcher holding watcher.lock? (No ps, no pid file: cheap enough for every focus hook.)"""
    try:
        ensure_state_dir()
        fh = WATCHER_LOCK.open("a+")
    except OSError:
        return False
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
        fcntl.flock(fh, fcntl.LOCK_UN)
        return False
    except OSError:
        return True
    finally:
        fh.close()


def ensure_watcher(replace_changed: bool = True, heal: bool = False, sweep: bool = False) -> str:
    """Make sure one watcher runs this code. Startup replaces a watcher running older code;
    a heal (replace_changed=False) only fills a gap. The new watcher itself waits on
    watcher.lock for an old one to finish its transaction, so two never tick at once.

    `sweep` (startup only, never a hook or a heal: those run under Herdr's in-flight cap and must not wait
    on ps and signals) first stops a watcher of THIS state dir that runs another copy of the script."""
    if sweep:
        stop_stray_watchers()
    cur = watcher_pid_record()
    alive = watcher_alive(cur)
    if alive and cur.get("stamp") == code_stamp():
        return f"watcher already running (pid {cur['pid']})"
    if alive and not replace_changed:
        return f"watcher running (pid {cur['pid']}, other code; `startup` replaces it)"
    if not alive and watcher_lock_held():
        return "watcher starting (its lock is held)"
    if alive:
        with contextlib.suppress(OSError):
            os.kill(cur["pid"], signal.SIGTERM)
        say(f"replacing watcher pid={cur['pid']} (plugin code changed)")
        for _ in range(5):
            time.sleep(1)
            try:
                os.kill(cur["pid"], 0)
            except OSError:
                break
    ensure_state_dir()
    env = {k: v for k, v in os.environ.items() if not (heal and k.startswith("HERDR_SLEEPER_"))}
    env["HERDR_BIN_PATH"] = HERDR_BIN
    child = subprocess.Popen([sys.executable, str(SELF), "watch"], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             stdin=subprocess.DEVNULL, env=env)
    return f"watcher spawned (pid {child.pid})"


def heal_watcher() -> None:
    """Called from every plugin activity: respawn a missing watcher. Never fails the caller.

    A healed watcher does not inherit HERDR_SLEEPER_* overrides from whatever invoked the
    command (a test's `HERDR_SLEEPER_IDLE=0s` must not become the service's window). A
    pre-watcher.lock watcher (v0.1.0) is replaced, so a plugin update takes effect on the
    next focus, not the next server start.
    """
    try:
        if watcher_lock_held():
            return  # a v0.1.1+ watcher runs (code changes are startup's business)
        # nothing holds the lock: no watcher, or one older than watcher.lock (v0.1.0), whose recorded
        # stamp differs — replaced the way startup does it (SIGTERM, wait), not left running old code
        msg = ensure_watcher(replace_changed=True, heal=True)
        if "spawned" in msg:
            say(f"healed: {msg}")
    except Exception as exc:  # healing is best effort; the command itself must still run
        say(f"WARN could not check the watcher: {exc}")


def load_clocks() -> dict[str, dict]:
    """Idle clocks from idle.json; missing, damaged, or malformed rows start fresh (a later sleep, never earlier).
    A v0.1.1-pass-1 row without a uuid never matches a live agent (clock_since), so it restarts too."""
    try:
        data = read_json(IDLE_FILE)
    except DamagedState as exc:
        say(f"WARN {exc}; idle clocks restart now; damaged file moved to {quarantine(IDLE_FILE)}")
        return {}
    except SleeperError:
        return {}
    clocks: dict[str, dict] = {}
    for pane, rec in data.items():
        since = rec.get("since") if isinstance(rec, dict) else None
        if isinstance(since, (int, float)) and not isinstance(since, bool) and math.isfinite(since):
            clocks[pane] = {"terminal_id": rec.get("terminal_id"), "seq": rec.get("seq"), "uuid": rec.get("uuid"),
                            "since": float(since)}
    return clocks


def note_skip(pane: str, reason: str) -> None:
    if LAST_SKIP.get(pane) != reason:
        LAST_SKIP[pane] = reason
        say(f"skip {pane}: {reason}")


def clock_key(agent: dict) -> dict:
    """What an idle stretch is tied to: the terminal, the agent's state_change_seq, and its session."""
    return {"terminal_id": agent.get("terminal_id"), "seq": agent.get("state_change_seq"),
            "uuid": (agent.get("agent_session") or {}).get("value")}


def clock_since(clocks: dict[str, dict], agent: dict, now: float) -> float | None:
    """The persisted start of this agent's idle stretch, or None when no record matches it exactly."""
    rec = clocks.get(agent["pane_id"])
    if not rec or rec["since"] > now or any(rec.get(k) != v for k, v in clock_key(agent).items()):
        return None
    return rec["since"]


def persist_clocks(clocks: dict[str, dict]) -> None:
    try:
        write_json(IDLE_FILE, clocks)
    except OSError as exc:
        say(f"WARN could not persist idle clocks: {exc}")


def watch_tick(clocks: dict[str, dict], config: dict) -> None:
    """One pass over `agent list`: advance idle clocks, sleep what is due, reconcile the journal.

    clocks[pane] = {terminal_id, seq, uuid, since}: the wall-clock start of the pane's
    current idle stretch, valid only while terminal id, `state_change_seq` and session all
    stay put. Herdr's seq is a server-global counter that restarts at 0 with the server and
    restore re-allocates terminal ids, so nothing identifies an idle stretch across a server
    restart; matching all of them keeps the clock across watcher restarts and restarts it
    (late, never early) after a server restart. Every reset is on disk (idle.json) before
    the first sleep transaction of the tick: a crash must not replay a stale `since`.
    """
    agents = list_agents()
    now = time.time()
    seen: set[str] = set()
    exclude = set(config["exclude"])
    before = json.dumps(clocks, sort_keys=True)
    repair = repair_kinds(config)
    with locked():
        try:
            merge_snapshot(agents, repair=repair)
        except DamagedState as exc:
            say(f"WARN {exc}; damaged snapshot moved to {quarantine(SNAPSHOT)}")
        try:
            reconcile(agents)
        except DamagedState as exc:
            say(f"WARN {exc}; damaged journal moved to {quarantine(JOURNAL)}")
        if repair:
            # relaunch panes that Herdr's restore brought back without their flags; a pane it
            # touched is out of this tick's sleep pass (its entry in `agents` is stale)
            try:
                touched = repair_restored(agents, config)
                agents = [a for a in agents if a["pane_id"] not in touched]
            except DamagedState as exc:
                say(f"WARN restore repair skipped: {exc}")
        try:
            journal = read_json(JOURNAL)
        except DamagedState as exc:
            say(f"WARN {exc}; damaged journal moved to {quarantine(JOURNAL)}")
            journal = {}
        # 1. clocks only: resets and pops, persisted before anything acts on them
        due: list[dict] = []
        for agent in agents:
            kind = agent.get("agent")
            if kind not in config["agents"]:
                continue
            pane = agent["pane_id"]
            seen.add(pane)
            if exclude and (pane in exclude or agent.get("name") in exclude):
                clocks.pop(pane, None)
                continue
            # `done` = idle-but-unviewed: its clock must accrue too or background-finished panes never sleep
            if agent.get("agent_status") not in SLEEPABLE_STATUSES or agent.get("focused") is not False:
                clocks.pop(pane, None)
                continue
            if clock_since(clocks, agent, now) is None:
                clocks[pane] = {**clock_key(agent), "since": now}
            if now - clocks[pane]["since"] >= config["idle_hours"] * 3600:
                due.append(agent)
        for pane in [p for p in clocks if p not in seen]:
            clocks.pop(pane, None)
        if json.dumps(clocks, sort_keys=True) != before:
            persist_clocks(clocks)
            before = json.dumps(clocks, sort_keys=True)
        # 2. sleep what is due; one pane failing in any way costs that pane, not the tick
        for agent in due:
            if STOP["requested"]:
                break  # a stopping watcher starts no new transaction
            pane, kind = agent["pane_id"], agent.get("agent")
            since = clocks[pane]["since"]
            try:
                # the gate sleep_agent assumes: no session, no transcript, open elsewhere ... -> skip, never raise
                ok, reason, _ = assess(agent, agents, config["idle_hours"], journal, exclude, idle_since=since)
                if not ok:
                    if not reason.startswith(QUIET_OUTCOMES):
                        note_skip(pane, reason)
                    continue
                uuid = (agent.get("agent_session") or {}).get("value")  # capture before sleep mutates the pane
                did, outcome = sleep_agent(agent, config["idle_hours"], exclude, dry_run=False,
                                           idle_since=since, notify_enabled=config["notify"])
            except SleeperError as exc:  # one flaky pane must not starve the rest of the tick
                did, outcome = False, f"error: {exc}"
            except Exception as exc:  # nor may a bug that only this pane's data triggers
                did, outcome = False, f"error: {type(exc).__name__}: {exc}"
            if did:
                say(f"slept {pane} ({agent.get('name') or kind}) uuid={uuid}")
                clocks.pop(pane, None)
                LAST_SKIP.pop(pane, None)
            elif not outcome.startswith(QUIET_OUTCOMES):
                note_skip(pane, outcome)
    if json.dumps(clocks, sort_keys=True) != before:
        persist_clocks(clocks)


def on_term(*_a: object) -> None:
    """SIGTERM (ensure_watcher replacing us): finish the transaction in hand, then exit."""
    STOP["requested"] = True
    say("watcher stopping (SIGTERM); finishing the current transaction first")


def pause(seconds: float) -> None:
    """Sleep in 1 s steps so a SIGTERM is honoured within a second, not after a whole poll."""
    for _ in range(max(1, int(math.ceil(seconds)))):
        if STOP["requested"]:
            return
        time.sleep(1)


def watch_loop() -> None:
    ensure_state_dir()
    lock_fh = take_watcher_lock()
    if lock_fh is None:
        print(f"another watcher holds {WATCHER_LOCK}; exiting")
        return
    try:
        signal.signal(signal.SIGTERM, on_term)
        try:
            started = code_stamp()
        except OSError:
            started = "gone"  # deleted between the import and now: the reload check logs it once
        write_json(WATCHER_PID, {"pid": os.getpid(), "stamp": started, "lock": True})  # 0600, atomic
        say(f"watcher start session={SESSION}")
        clocks = load_clocks()
        failures = 0
        told: set[str] = set()  # reload verdicts already logged (a verdict is logged once)
        reloader = ReloadCheck(started)
        while not STOP["requested"]:
            rec = watcher_pid_record()
            if rec and rec.get("pid") != os.getpid() and watcher_alive(rec):
                say("watcher superseded; exiting")  # e.g. an older version's watcher took the pid file
                return
            # Self-reload, once per tick and before the tick's work: between transactions, the global lock not
            # held. A deploy needs no restart; a Herdr restart cannot leave old code running its first tick.
            verdict, detail = reloader.look()
            if verdict == "reload" and not STOP["requested"] and f"reload-failed {detail}" not in told:
                reload_watcher(lock_fh, started, detail)  # returns only if the exec failed
                told.add(f"reload-failed {detail}")
            elif verdict in ("gone", "incomplete", "unrunnable") and f"{verdict} {detail}" not in told:
                told.add(f"{verdict} {detail}")
                say("WARN watcher script " + {
                    "gone": f"{detail} is gone or unreadable; keeping the code already loaded",
                    "incomplete": f"changed on disk ({detail}) but is not a complete Python file yet; "
                                  "waiting for a complete one",
                    "unrunnable": f"changed on disk ({detail}) and does not start; keeping the code already loaded",
                }[verdict])
            try:
                config, _src = load_config()
                poll = max(1.0, float(config["poll_seconds"]))
            except ConfigError as exc:
                say(f"error: sleeping disabled by broken config — {exc}")
                pause(300)
                continue
            try:
                watch_tick(clocks, config)
                if failures:
                    say(f"tick recovered after {failures} failure(s)")
                failures = 0
            except SleeperError as exc:
                failures += 1
                say(f"tick-error: {exc}")
            except Exception as exc:  # a bug must cost one tick, never the service
                failures += 1
                where = " | ".join(traceback.format_exc().strip().splitlines()[-3:-1])
                say(f"tick-error: {type(exc).__name__}: {exc} ({where})")
            delay = poll if not failures else min(WATCHER_BACKOFF_MAX, poll * 2 ** min(failures, 10))
            if failures:
                say(f"backing off {delay:g}s after {failures} failed tick(s)")
            pause(delay)
        say("watcher stopped")
    finally:
        lock_fh.close()


# ------------------------------------------------------------- focus hook

def wake_lock(pane: str):
    """One click fires several pane.focused hooks (workspace→tab→pane); only the first may act.

    Returns a release callable, or None when a recent holder is on this pane.
    """
    path = STATE_DIR / f".{pane.replace(':', '_')}.wakelock"
    ensure_state_dir()
    for _ in range(2):
        try:
            fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            os.write(fd, str(os.getpid()).encode())
            os.close(fd)

            def release() -> None:
                with contextlib.suppress(OSError):
                    os.unlink(path)

            return release
        except FileExistsError:
            try:
                if time.time() - path.stat().st_mtime < 120:  # agent start waits up to 60s; older is a dead holder
                    return None
                path.unlink()
            except OSError:
                return None
    return None


def cmd_on_focus() -> int:
    heal_watcher()
    raw = os.environ.get("HERDR_PLUGIN_EVENT_JSON") or "{}"
    try:
        pane = ((json.loads(raw).get("data") or {}).get("pane_id")
                or json.loads(raw).get("pane_id"))
    except ValueError:
        return 0
    if not pane:
        return 0
    try:
        row = read_json(JOURNAL).get(pane)
    except (SleeperError, DamagedState):
        return 0
    if not isinstance(row, dict) or row.get("phase") in ("displaced", "orphaned"):
        return 0  # cheap path: nothing of ours (orphans are keyed `orphan:`), or a pane that runs another session
    try:
        config, _src = load_config()
        if not config["wake_on_focus"]:
            return 0
    except ConfigError:
        return 0
    release = wake_lock(pane)
    if not release:
        return 0
    try:
        outcome: bool | str = False
        with locked(timeout=FOCUS_LOCK_WAIT_SECONDS):  # never queue behind a long transaction; refocus retries
            hit = find_journal_entry(pane)
            if hit and not is_orphan(hit[0], hit[1]):
                outcome = wake_entry(hit[1], via="focus", key=hit[0])
        if hit and outcome == DELEGATED:
            # `y` + Enter went to the pane's stub: confirm it outside the global lock (the stub needs it),
            # which finishes the `waking` row and hands the name back now rather than a tick later
            await_stub_wake(hit[1])
    except SleeperError as exc:
        say(f"on-focus {pane}: {exc}")
    finally:
        release()
    return 0


# -------------------------------------------------------------- migration

def migrate_legacy() -> None:
    """One-time adoption of the standalone script's journal for this session."""
    if SESSION != "default" or JOURNAL.exists():
        return
    legacy = LEGACY_STATE_DIR / "sleeping.json"
    if not legacy.exists():
        return
    try:
        data = json.loads(legacy.read_text())
    except (OSError, ValueError):
        say("migration: legacy journal unreadable; starting empty (the legacy file is untouched)")
        return
    if not isinstance(data, dict):
        say("migration: legacy journal is not an object; starting empty (the legacy file is untouched)")
        return
    entries = {p: {**e, "kind": e.get("kind") or "claude"} for p, e in data.items()
               if isinstance(e, dict) and isinstance(e.get("uuid"), str)}
    if entries:
        write_json(JOURNAL, entries)
    event("migrated", entries=len(entries), source=str(legacy))
    say(f"migrated {len(entries)} legacy journal entr{'y' if len(entries) == 1 else 'ies'} from {legacy}")


MIGRATABLE_KEYS = {"idle", "idle_hours", "exclude", "interval_minutes", *DEFAULTS}


def toml_value(v: object) -> str:
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return repr(v)
    if isinstance(v, str) and not set(v) & {'"', "\\", "\n"}:
        return f'"{v}"'
    if isinstance(v, list) and all(isinstance(x, str) for x in v):
        return "[" + ", ".join(toml_value(x) for x in v) + "]"
    raise ConfigError(f"cannot translate value {v!r}")


def migrate_legacy_config() -> None:
    """One-time translation of an older config into the file Herdr points the plugin at.

    Only when CONFIG_FILE is missing: an existing plugin config is never rewritten
    (a stray older file is pointed out in the log instead). `interval_minutes` (the
    standalone script's launchd cadence) is dropped; unknown keys or values we cannot
    translate refuse the migration, and load_config then keeps sleeping off.
    """
    if CONFIG_FILE.exists():
        for old in LEGACY_CONFIG_FILES:
            if old.exists() and not same_dir(str(old), str(CONFIG_FILE)):
                say(f"WARN {old} is not read: the plugin reads {CONFIG_FILE} (an older config is migrated only "
                    "when that file is missing); merge what you still want and delete the old file")
        return
    for old in LEGACY_CONFIG_FILES:
        if not old.exists():
            continue
        try:
            raw = parse_toml(old)
            unknown = sorted(set(raw) - MIGRATABLE_KEYS)
            if unknown:
                raise ConfigError(f"unknown key(s) {unknown}")
            lines = [f"# migrated by herdr-sleeper {dt.date.today().isoformat()} from {old}",
                     "# (interval_minutes dropped: the watcher polls every poll_seconds)"]
            lines += [f"{k} = {toml_value(v)}" for k, v in raw.items() if k != "interval_minutes"]
        except Exception as exc:  # TOMLDecodeError, OSError, ConfigError
            say(f"WARN not migrating {old}: {exc}; sleeping stays off until {CONFIG_FILE} exists")
            return
        CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
        fd, tmp = tempfile.mkstemp(prefix=CONFIG_FILE.name + ".", suffix=".tmp", dir=CONFIG_FILE.parent)
        with os.fdopen(fd, "w") as fh:
            fh.write("\n".join(lines) + "\n")
        os.replace(tmp, CONFIG_FILE)
        event("config-migrated", source=str(old), target=str(CONFIG_FILE))
        say(f"migrated config {old} -> {CONFIG_FILE}")
        return


# ------------------------------------------------------------------- CLI

def cmd_startup() -> int:
    migrate_legacy()
    migrate_legacy_config()
    print(ensure_watcher(sweep=True))
    return 0


def context_pane() -> str | None:
    """The pane a plugin action was invoked on. Herdr always sets HERDR_PLUGIN_CONTEXT_JSON for
    plugin commands; when it is there, it is the only source (a HERDR_PANE_ID inherited by the
    server from an outer session would name another session's pane). Manual runs fall back."""
    raw = os.environ.get("HERDR_PLUGIN_CONTEXT_JSON")
    if raw is None:
        return os.environ.get("HERDR_PANE_ID")
    try:
        ctx = json.loads(raw or "{}")
    except ValueError:
        return None
    return (ctx.get("focused_pane_id") or ctx.get("pane_id")) if isinstance(ctx, dict) else None


def cmd_sleep_pane(args: argparse.Namespace) -> int:
    heal_watcher()
    pane = args.pane or context_pane()
    if not pane:
        print("no pane context; pass a pane id", file=sys.stderr)
        return 2
    try:
        config, _src = load_config()
    except ConfigError as exc:
        print(f"error: broken config — {exc}", file=sys.stderr)
        return 2
    agent = next((a for a in list_agents() if a["pane_id"] == pane), None)
    if not agent or not agent.get("agent"):
        print(f"{pane}: no agent to sleep", file=sys.stderr)
        return 1
    with locked():
        try:
            slept, outcome = sleep_agent(agent, config["idle_hours"], set(config["exclude"]),
                                         dry_run=args.dry_run, allow_focused=True, notify_enabled=config["notify"])
        except SleeperError as exc:
            slept, outcome = False, f"error: {exc}"
    print(f"{pane}: {outcome}" if not slept else f"slept {pane}: {outcome}")
    return 0 if slept or args.dry_run else 1


def cmd_scan(args: argparse.Namespace) -> int:
    """One watcher-style tick on demand (used by tests and by hand).

    Honours the idle window: a pane's idle stretch is the watcher's persisted clock when one
    matches it exactly, else it starts now (so only a 0 window sleeps an unclocked pane). It
    reads idle.json and never writes it — the watcher owns the clocks.
    """
    heal_watcher()
    try:
        config, _src = load_config()
    except ConfigError as exc:
        print(f"error: refusing to scan with a broken config — {exc}", file=sys.stderr)
        return 2
    exclude = set(config["exclude"]) | set(args.exclude or [])
    rows = []
    slept = 0
    with locked():
        agents = list_agents()
        merge_snapshot(agents, repair=repair_kinds(config))
        reconcile(agents)
        journal = read_json(JOURNAL)
        clocks, now = load_clocks(), time.time()
        for agent in agents:
            since = clock_since(clocks, agent, now)
            since = now if since is None else since
            ok, reason, _idle = assess(agent, agents, config["idle_hours"], journal, exclude, idle_since=since)
            outcome = reason
            if ok:
                try:
                    did, outcome = sleep_agent(agent, config["idle_hours"], exclude, dry_run=args.dry_run,
                                               idle_since=since, notify_enabled=config["notify"])
                except SleeperError as exc:
                    did, outcome = False, f"error: {exc}"
                slept += did
            rows.append({"pane": agent["pane_id"], "name": agent.get("name"),
                         "status": agent.get("agent_status"), "eligible": ok, "outcome": outcome})
    for r in rows:
        mark = "SLEEP" if r["outcome"] == "slept" else "would" if r["outcome"].startswith("would") else "keep "
        print(f"{mark} {r['pane']:8} {(r['name'] or '-'):20} {r['status'] or '-':8} {r['outcome']}")
    print(f"{slept} slept, {len(rows)} inspected, idle window {config['idle_hours']:g}h"
          + (" (dry run)" if args.dry_run else ""))
    return 0


def manifest_version() -> str:
    """`version` from the herdr-plugin.toml next to the script, or "unknown"."""
    try:
        text = (SELF.parent / "herdr-plugin.toml").read_text()
    except OSError:
        return "unknown"
    m = re.search(r'(?m)^version\s*=\s*"([^"]+)"', text)
    return m.group(1) if m else "unknown"


def cmd_version(_args: argparse.Namespace) -> int:
    """One line to check a deploy: manifest version, script path, code stamp, and the running watcher's pid and
    stamp (`current` when it runs this very script version, `STALE` when not). Read-only: it starts nothing and
    heals nothing."""
    try:
        stamp_now = code_stamp()
    except OSError:
        stamp_now = "unreadable"
    rec = watcher_pid_record()
    if rec and watcher_alive(rec):
        ws = rec.get("stamp") or "unknown"
        watcher = f"pid {rec['pid']} stamp {ws} ({'current' if ws == stamp_now else 'STALE'})"
    else:
        watcher = "none running"
    print(f"herdr-sleeper {manifest_version()} script {SELF} stamp {stamp_now} watcher {watcher}")
    return 0


def cmd_list(_args: argparse.Namespace) -> int:
    heal_watcher()
    try:
        journal = read_json(JOURNAL)
    except DamagedState as exc:
        print(f"damaged journal: {exc}", file=sys.stderr)
        return 2
    repairs = pending_repairs()
    if not journal:
        print("nothing is sleeping")
        if not repairs:
            return 0
    for pane, e in sorted(journal.items()):
        if not valid_entry(e):
            print(f"{'?':20} {pane:8} malformed entry")
            continue
        phase = "orphaned" if is_orphan(pane, e) else e.get("phase", "asleep")
        if e.get("restore_repair"):  # a restore repair that stopped half way: `herdr-sleeper wake <name>` (or the sidebar) finishes it
            phase += "+repair"
        print(f"{wake_name(e):20} {pane:8} {e.get('kind', 'claude'):9} {phase:15} "
              f"slept {e.get('slept_at') or '?':20} {e.get('title') or ''}")
        if phase in ("orphaned", "displaced"):  # never woken automatically: say how to do it by hand
            print(f"{'':20} manual: {manual_command(e)}")
    for pane, row, marker in repairs:  # restored without their launch flags; the watcher is waiting on a gate
        flags, _why = replayable_argv(row.get("argv") or [], row.get("kind") or "claude")
        print(f"{row.get('name') or wake_name({'pane_id': pane}):20} {pane:8} {row.get('kind', 'claude'):9} "
              f"{'repair-' + str(marker.get('state')):15} restored without {shlex.join(flags or [])} since "
              f"{marker.get('first_seen') or '?'}" + (f" ({marker['reason']})" if marker.get("reason") else ""))
    return 0


def cmd_log(args: argparse.Namespace) -> int:
    if not EVENTS.exists():
        print("(no events yet)")
        return 0
    lines = EVENTS.read_text().splitlines()
    for line in (lines[-args.tail:] if args.tail else lines):
        print(line)
    return 0


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(prog="herdr-sleeper", description="sleep idle Herdr agents; wake them later")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("startup", help="ensure the watcher (idempotent)").set_defaults(
        fn=lambda _a: cmd_startup())
    sp = sub.add_parser("sleep-pane", help="sleep the context pane (or PANE) now")
    sp.add_argument("pane", nargs="?")
    sp.add_argument("--dry-run", action="store_true")
    sp.set_defaults(fn=cmd_sleep_pane)
    wp = sub.add_parser("wake", help="wake one sleeping agent (pane id, wake name, or agent name)")
    wp.add_argument("target", nargs="?")
    wp.add_argument("--all", action="store_true")
    wp.set_defaults(fn=cmd_wake)
    sub.add_parser("wake-all", help="wake every sleeping agent").set_defaults(fn=lambda a: cmd_wake(
        argparse.Namespace(target=None, all=True)))
    sub.add_parser("list", help="what is sleeping").set_defaults(fn=cmd_list)
    sub.add_parser("version", help="manifest version, script, code stamp, running watcher (read-only)").set_defaults(
        fn=cmd_version)
    lp = sub.add_parser("log", help="events, newest last")
    lp.add_argument("--tail", type=int, default=None)
    lp.set_defaults(fn=cmd_log)
    sub.add_parser("on-focus", help="pane.focused hook (internal)").set_defaults(fn=lambda a: cmd_on_focus())
    sub.add_parser("watch", help="the idle watcher loop (internal)").set_defaults(fn=lambda a: watch_loop() or 0)
    stp = sub.add_parser("stub", help="in-pane wake stub (internal)")
    stp.add_argument("pane")
    stp.add_argument("uuid")
    stp.add_argument("state_dir", nargs="?", default=None)
    stp.set_defaults(fn=lambda a: cmd_stub(a.pane, a.uuid, a.state_dir))

    scp = sub.add_parser("scan", help="one tick on demand")
    scp.add_argument("--dry-run", action="store_true")
    scp.add_argument("--exclude", action="append")
    scp.set_defaults(fn=cmd_scan)
    args = p.parse_args(argv)
    return args.fn(args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except SleeperError as exc:
        say(f"error: {exc}")
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)

# ------------------------------------------------ every kind Herdr's restore relaunches

# Herdr's restore (src/agent_resume.rs `plan()`) relaunches each restorable agent kind from its session ref
# alone: the binary, a resume flag, the id, and nothing else, so every launch flag the operator typed is lost.
# This table is the one place that knows, per kind, how to put them back. Kinds Herdr never relaunches
# (gemini, cline, kiro, amp, maki, muse) have no entry: there is nothing to repair.
#
#   binary    the executable (the `agent` label is not always one: cursor is `cursor-agent`)
#   resume    how Herdr spells "resume this session" and how we do on wake: ("flag", "--resume") is
#             `--resume ID`, ("eq", "--resume") is `--resume=ID`, ("sub", "resume") is `resume ID`. We use
#             Herdr's own form, except that opencode keeps its short `-s` (the sleep path always did)
#   strip     what a replayed argv drops because the resume tokens replace it: "value" options (their value
#             goes too), "optional" ones (`--resume [id]`: the value goes if there is one), "named" ones
#             (the same, but the value is a session NAME, hermes `--continue [NAME]`: stripped, never taken
#             for a session id), "bare" ones (`--continue`, `--last`: "the most recent session", which is
#             not the session we are resuming)
#   values    options that take exactly one value; bools the flags that take none; refused the one-shot,
#             print, prompt, fork, new-state and secret-bearing options that must never be replayed. All three
#             come from the CLI's own `--help` on this machine, see `verified`.
#   mode      "allow": claude's own allow-list (REFUSED/BOOLEAN/VALUE_OPTIONS below, unchanged since v0.1).
#             "deny": the kind's `values` and `bools` lists are an allow-list too (v0.1.2 review: an unlisted
#             `--long=value` used to replay, secrets included): any option not in them is refused, which leaves
#             that pane alone. "none": the CLI was not available to read, so nothing but the
#             resume tokens may be in the argv: such a pane is recorded but never repaired.
#   verified  True when `<binary> --help` was read on this machine; False means "none" mode, above.
#   bypass    options that skip permission prompts or sandboxing (an option here is also listed in values/bools,
#             or is claude's). Restore repair puts them back only under `[restore] repair_bypass = true`
#             (default off); otherwise it restores the other recorded flags and leaves these out.
#   composer  name of a pane-screen detector in COMPOSER_DETECTORS, or None where the screen gives no
#             reliable signal (see composer_refusal).
# In every mode: `--`, a positional argument (an initial prompt, a subcommand) and a missing value refuse.
def _kind(binary: str, resume: tuple[str, str], strip: dict | None = None, values: str = "", bools: str = "",
          refused: str = "", mode: str = "deny", verified: bool = True, composer: str | None = None,
          bypass: str = "") -> dict:
    strip = strip or {}
    return {"bypass": frozenset(bypass.split()),"binary": binary, "resume": resume, "mode": mode, "verified": verified, "composer": composer,
            "strip_value": frozenset(strip.get("value", ())), "strip_optional": frozenset(strip.get("optional", ())),
            "strip_bare": frozenset(strip.get("bare", ())), "strip_named": frozenset(strip.get("named", ())),
            "values": frozenset(values.split()),
            "bools": frozenset(bools.split()), "refused": frozenset(refused.split())}


# devin, droid, qodercli, grok, kimi, mastracode, pi, kilo and letta: "none" mode, nothing but the resume tokens
# is ever replayed, so they have no bypass list. `pi --help` 1.6.0 was read: its -a/--approve trusts
# project-local files; it is not replayed. The others are not installed here (not checked).
def _unread(binary: str, resume: tuple[str, str], strip_value: tuple[str, ...] = ()) -> dict:
    return _kind(binary, resume, {"value": (resume[1], *strip_value)}, mode="none", verified=False)


